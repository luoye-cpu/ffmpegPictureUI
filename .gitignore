# ═══════════════════════════════════════════════════════════
#  FFmpegPictureUI .gitignore
#  规范化: 所有测试/临时产物统一放 tests/output/ (git 忽略)
#  外部工具二进制、第三方库源码、编译产物一律不跟踪
# ═══════════════════════════════════════════════════════════

# ── .NET 编译输出 ──
bin/
obj/
*.user
*.suo
*.vs/
*.DotSettings.user

# ── 发布输出 ──
publish/
dist/

# ── 日志文件 ──
*.log
error.log
output.log
*.etl

# ── 调试符号 ──
*.pdb

# ── NuGet 缓存 / 生成器输出 ──
*.nuget.*
project.assets.json
*.nuget.dgspec.json

# ── 压缩包（不应提交到源码仓库）──
*.zip
*.7z
*.rar
*.gz
*.tar

# ── 操作系统垃圾文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE 缓存 ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── 临时文件 ──
*.tmp
*.temp
*.cache
*.swp
~$*

# ═══════════════════════════════════════════════════════════
#  测试/临时产物统一规范
#  所有测试产生的文件（图片、编码产物、日志、临时文件）一律放 tests/output/
#  该目录整体不跟踪；tests/scripts/ 下的脚本应被跟踪
# ═══════════════════════════════════════════════════════════
tests/output/
tests/tmp/
tests/*.log
tests/*.jsonl
tests/*.txt
tests/_*.log
# 本机测试配置（含绝对路径，勿提交；提供 *.template.json 模板）
tests/**/settings.json
# 历史遗留测试输出目录名（兼容旧脚本）
test_output/
test-output/
temp_e2e/
temp_headless_test/
temp_headless_test2/
output/
temp_*/

# ═══════════════════════════════════════════════════════════
#  第三方库源码（嵌套 Git 仓库 / 手动下载源码，不跟踪）
# ═══════════════════════════════════════════════════════════
tools/src/aom/
tools/src/dcraw/
tools/src/jxrlib/
tools/src/jpegli/
tools/src/libjxl/
tools/src/libavif/
tools/src/libultrahdr/
tools/src/zlib/
# DNG 构建依赖（手动下载, 见 tools/BUILD_TOOLS.md 或 docs/DNG_BUILD.md）
tools/src/dng_sdk/
tools/src/libraw/
# 注：tools/src/dngjxlprobe/ 的**源码**（DngJxlProbe.csproj / Program.cs）是跟踪的，
#     故此处不整体忽略该目录；其 bin/obj 由上方通用规则 bin/ obj/ 覆盖。

# ── CMake 构建产物 ──
tools/src/install/
tools/src/**/build/
tools/src/**/CMakeFiles/
tools/src/**/*.tlog/
**/CMakeCache.txt
**/cmake_install.cmake
**/CMakeFiles/

# ── 静态库/目标文件/可执行文件（编译产物）──
*.lib
*.a
*.obj
*.o
*.so
*.so.*
*.dylib
tools/src/**/*.exe
tools/src/**/*.dll

# ── 嵌套 Git 仓库元数据 ──
tools/src/**/.git/
tools/src/libraw/.git/

# ═══════════════════════════════════════════════════════════
#  外部工具二进制（不应提交到源码仓库）
#  测试项目 GainMapTestHost 下的 PLAN 工具副本也不跟踪
# ═══════════════════════════════════════════════════════════
**/cjxl.exe
**/djxl.exe
**/cjpegli.exe
**/exiftool.exe
**/exiftool(-k).exe
**/exiftool_files/
**/JxrEncApp.exe
**/JxrDecApp.exe
**/avifenc.exe
**/dngtool.exe
**/ultrahdr_app.exe
**/avif.dll
**/ffmpeg.exe
**/ffprobe.exe
**/plan_test.json
tests/GainMapTestHost/PLAN/

# ── 临时杂项 ──
.fake
*.orig
*.rej

# ── 一次性诊断脚本归档（无长期价值，忽略）──
tests/scripts/_archived_diag/

# ═══════════════════════════════════════════════════════════
#  标准/规范文档（大体积二进制，按需单独获取，不跟踪）
# ═══════════════════════════════════════════════════════════
tools/std/

# ═══════════════════════════════════════════════════════════
#  开发辅助与内部记录（含本机绝对路径与内部笔记，禁止公开）
# ═══════════════════════════════════════════════════════════
.workbuddy-ai/
NVIDIA Corporation/
_guishot.ps1
# 运行时用户状态（含 FfmpegDirectory 等本机绝对路径，程序会自动重建）
/settings.json
settings.json

