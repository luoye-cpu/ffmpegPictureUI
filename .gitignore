# ── .NET 编译输出 ──
bin/
obj/
*.user
*.suo
*.vs/
*.DotSettings.user

# ── 发布输出 ──
publish/

# ── 日志文件 ──
*.log
error.log
output.log
*.etl

# ── 调试符号 ──
*.pdb

# ── NuGet 缓存 / 生成器输出 ──
*.nuget.*
project.assets.json
*.nuget.dgspec.json

# ── 压缩包（不应提交到源码仓库）──
*.zip
*.7z
*.rar

# ── 操作系统垃圾文件 ──
.DS_Store
Thumbs.db

# ── IDE 缓存 ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── 临时文件 ──
*.tmp
*.temp
*.cache

# ── 第三方库源码（嵌套 Git 仓库，不从本仓库追踪） ──
tools/src/aom/
tools/src/dcraw/
tools/src/jxrlib/
# DNG 构建依赖（手动下载, 见 tools/BUILD_TOOLS.md 或 docs/DNG_BUILD.md）
tools/src/dng_sdk/
tools/src/libraw/

# ── CMake 构建产物（install 目录、build/CMakeFiles 等）──
tools/src/install/
tools/src/**/build/
tools/src/**/CMakeFiles/
tools/src/**/*.tlog/
**/CMakeCache.txt
**/cmake_install.cmake
**/CMakeFiles/

# ── 静态库/目标文件（编译产物，源码仓库不应包含）──
tools/src/**/*.lib
tools/src/**/*.a
tools/src/**/*.obj
tools/src/**/*.o
tools/src/**/*.exe
tools/src/**/*.dll

# ── 嵌套 Git 仓库元数据（已转为普通源码目录的第三方库）──
tools/src/libraw/.git/

# ── DNG SDK 测试样本与库测试数据（构建不需要, 体积大）──
tools/src/dng_sdk/**/sample_files/
tools/src/dng_sdk/**/test_data.js
tools/src/dng_sdk/**/test_data.tar

# ── DNG SDK 不需要的组件 ──
# xmp/ (2312 文件): 编译使用 qDNGUseXMP=0, 完全不需要 XMP toolkit
tools/src/dng_sdk/**/xmp/
# 平台项目文件 / CI 配置 / 文档 (Windows 构建不需要)
tools/src/dng_sdk/**/.github/
tools/src/dng_sdk/**/win/
tools/src/dng_sdk/**/mac/
tools/src/dng_sdk/**/*.pdf

# ── 外部工具二进制（不应提交到源码仓库） ──
**/cjxl.exe
**/djxl.exe
**/cjpegli.exe
**/exiftool.exe
**/exiftool(-k).exe
**/exiftool_files/

# ── 测试输出目录 ──
test_output/
test-output/

.fake