<Window
    x:Class="FfmpegGui.FormatFilterWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:FfmpegGui"
    Title="{ext:Loc filter.title}"
    Width="360" Height="560"
    WindowStartupLocation="CenterOwner"
    CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Text="{ext:Loc filter.subtitle}"
               FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

    <ScrollViewer Grid.Row="1">
      <StackPanel x:Name="FormatCheckPanel" Spacing="8">
        <!-- CheckBoxes 由代码动态生成 -->
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="{ext:Loc filter.btn.selectall}" Click="SelectAll_Click" Padding="10,4"/>
      <Button Content="{ext:Loc filter.btn.deselectall}" Click="DeselectAll_Click" Padding="10,4"/>
      <Button Content="{ext:Loc filter.btn.ok}" Click="Ok_Click" Padding="12,4" IsDefault="True"/>
      <Button Content="{ext:Loc filter.btn.cancel}" Click="Cancel_Click" Padding="12,4" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
