<Window
    x:Class="FfmpegGui.PresetManagerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:local="using:FfmpegGui.Models"
    Title="📋 预设管理"
    Width="560" Height="520"
    WindowStartupLocation="CenterOwner"
    CanResize="True"
    MinWidth="420" MinHeight="360">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" ColumnDefinitions="*">
    <!-- 标题 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="📋 预设管理" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="选择一个预设应用到当前参数，或将当前设置另存为新预设"
                 FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </StackPanel>

    <!-- 预设列表 + 操作按钮 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="*">
      <!-- 预设列表 -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
        <ListBox x:Name="PresetListBox" SelectionMode="Single"
                 SelectionChanged="PresetList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:PresetEntry">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                <Border CornerRadius="3" Padding="4,1"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <TextBlock Text="{Binding Source}" FontSize="9"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 操作按钮列 -->
      <StackPanel Grid.Column="1" Spacing="6" Width="100">
        <Button Content="✅ 应用预设" Click="Apply_Click"
                Padding="8,4" FontSize="11"
                ToolTip.Tip="将选中预设的参数应用到主界面"/>
        <Separator Height="4" Background="Transparent"/>
        <Button Content="💾 另存当前" Click="SaveCurrent_Click"
                Padding="8,4" FontSize="11"
                ToolTip.Tip="将当前主界面的参数另存为新预设"/>
        <Button Content="📥 导入文件" Click="ImportFile_Click"
                Padding="8,4" FontSize="11"
                ToolTip.Tip="从外部 .json 文件导入预设"/>
        <Button Content="🗑 删除选中" Click="Delete_Click"
                Padding="8,4" FontSize="11"
                ToolTip.Tip="删除选中的用户预设（内置预设不可删除）"/>
        <Separator Height="4" Background="Transparent"/>
        <Button x:Name="ApplyCloseBtn" Content="应用并关闭" Click="ApplyClose_Click"
                Padding="8,4" FontSize="11" IsDefault="True"
                ToolTip.Tip="应用选中预设并关闭窗口"/>
        <Button Content="取消" Click="Cancel_Click"
                Padding="8,4" FontSize="11" IsCancel="True"/>
      </StackPanel>
    </Grid>

    <!-- 底部：当前选中预设的详情 -->
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="3">
        <TextBlock x:Name="DetailTitle" Text="选择一个预设查看详情"
                   FontSize="12" FontWeight="Bold"/>
        <TextBlock x:Name="DetailText" Text=""
                   FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
