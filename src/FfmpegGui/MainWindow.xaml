<Window
    x:Class="FfmpegGui.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:local="using:FfmpegGui.Models"
    xmlns:ext="using:FfmpegGui"
    Icon="avares://FfmpegGui/Resources/icon_raw.png"
    Title="{ext:Loc app.title}"
    Height="850"
    Width="1100"
    MinHeight="700"
    MinWidth="900"
    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- ⚠ 组件层面修复（2026-09-16）：NumericUpDown 沿用 Fluent 默认字号（约 14），
         而左侧面板内容可用宽仅约 236px、数字框多为固定宽度 ⇒ 默认字号下数值会被
         右侧上下微调按钮挤掉/截断。本项目 TextBox 已有 11 处显式设 FontSize，
         NumericUpDown 却只有 1 处 ⇒ 口径不一致。这里统一到 13，与 TextBox 对齐。 -->
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="13"/>
      <!-- 统一最小宽度：保证「上下微调按钮 + 至少 4 位数字」都放得下。
           实测 Spinner 按钮约占 18~24px、模板 TextBox 内边距约 8px、4 位数字约 32px
           ⇒ 理论下限约 64px；取 88 留余量（覆盖 3200 / 7680 这类 4 位数）。
           注意：控件上显式写的 MinWidth/Width 优先级更高，不受本默认值影响。 -->
      <Setter Property="MinWidth" Value="88"/>
    </Style>
    <!-- 数值框内的 TextBox 同样统一（模板内层，Selector 需带 /template/） -->
    <Style Selector="NumericUpDown /template/ TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <!-- ⚠ 继续改进（2026-09-16）：Fluent 默认的上下微调按钮偏宽（约 24px），
         在窄数字框里会明显挤压数值区。这里把按钮收窄到 18px —— 仍可点击
         （Avalonia 的 RepeatButton 无最小命中尺寸限制），但把省下的宽度让给数值本身。 -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
      <Setter Property="Width" Value="18"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- ═══════════ 完整模式主界面 ═══════════ -->
    <DockPanel x:Name="FullModePanel">
    <!-- 顶部工具栏卡片 -->
    <Border DockPanel.Dock="Top" Margin="12,8,12,4" Padding="14,10"
            CornerRadius="10" BoxShadow="0 2 12 0 #18000000"
            Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
        <!-- Row 0: FFmpeg 目录 + 输出目录 同一行（2026-08-16: 合并两行节省纵向空间；
             Grid 弹性列宽：输入框随窗口伸缩，任何窗口宽度均不溢出（修复窄窗口下
             固定 220px 溢出到右侧按钮区的缺陷）。
             2026-08-16 二次修复: 修复列定义与元素错位（输出目录标签曾落入 12px 固定列、
             输入框落入 Auto 列导致宽度塌陷）→ 输出目录列 1.4 倍权重 -->
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto,1.4*,Auto">
          <TextBlock Text="{ext:Loc ffmpeg.dir}" VerticalAlignment="Center" FontSize="13"/>
          <TextBox x:Name="FfmpegPathBox" Grid.Column="1" MinWidth="120" Margin="10,0,0,0"
                   VerticalAlignment="Center" IsReadOnly="True"
                   ToolTip.Tip="{Binding Text, ElementName=FfmpegPathBox}"/>
          <Button Grid.Column="2" Content="{ext:Loc browse}" Click="BrowseFfmpeg_Click" Padding="8,4" Margin="6,0,0,0"/>
          <TextBlock Grid.Column="3" Text="{ext:Loc output.dir}" VerticalAlignment="Center" FontSize="13" Margin="16,0,10,0"/>
          <TextBox x:Name="OutputDirBox" Grid.Column="4" MinWidth="160" Margin="0,0,0,0"
                   VerticalAlignment="Center" IsReadOnly="True"
                   ToolTip.Tip="{Binding Text, ElementName=OutputDirBox}"/>
          <Button Grid.Column="5" Content="{ext:Loc browse}" Click="BrowseOutputDir_Click" Padding="8,4" Margin="6,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
          <!-- ⚙ 设置菜单（二级菜单）：把原先散落在右上角的 4 个按钮收拢，
               并新增「渲染后端」——用于手动选择 GPU / Vulkan / 软件渲染。 -->
          <Button x:Name="SettingsMenuBtn" Content="⚙" FontSize="15" Padding="9,2"
                  ToolTip.Tip="{ext:Loc settings.tip}">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{ext:Loc settings.render}">
                  <MenuItem x:Name="RenderAutoItem"     Header="{ext:Loc settings.render.auto}"     Tag="auto"     Click="RenderModeMenu_Click"/>
                  <MenuItem x:Name="RenderAngleItem"    Header="{ext:Loc settings.render.angle}"    Tag="angle"    Click="RenderModeMenu_Click"/>
                  <MenuItem x:Name="RenderVulkanItem"   Header="{ext:Loc settings.render.vulkan}"   Tag="vulkan"   Click="RenderModeMenu_Click"/>
                  <MenuItem x:Name="RenderSoftwareItem" Header="{ext:Loc settings.render.software}" Tag="software" Click="RenderModeMenu_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{ext:Loc settings.theme}">
                  <MenuItem x:Name="ThemeDarkItem"  Header="{ext:Loc settings.theme.dark}"  Tag="dark"  Click="ThemeMenu_Click"/>
                  <MenuItem x:Name="ThemeLightItem" Header="{ext:Loc settings.theme.light}" Tag="light" Click="ThemeMenu_Click"/>
                </MenuItem>
                <MenuItem Header="{ext:Loc settings.lang}">
                  <!-- 语言项按惯例显示**各语言的自称**，不随界面语言翻译 -->
                  <MenuItem x:Name="LangZhItem" Header="中文"    Tag="zh-CN" Click="LangMenu_Click"/>
                  <MenuItem x:Name="LangEnItem" Header="English" Tag="en-US" Click="LangMenu_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="CacheDirItem"  Header="{ext:Loc settings.cache.set}" Tag="cachedir" Click="CacheDirMenu_Click"/>
                <MenuItem x:Name="CacheShowItem" Header="{ext:Loc settings.cache.open}" Click="OpenCacheDirMenu_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- 旧按钮保留但隐藏：C# 里仍引用它们做状态同步，删除会连带改多处逻辑；
               隐藏后用户不可见，功能已全部并入上方 ⚙ 菜单。 -->
          <Button x:Name="CacheToggleBtn" Content="🗂" FontSize="11" Padding="6,2" IsVisible="False"
                  ToolTip.Tip="{ext:Loc tip.cache.toggle}" Click="ToggleCachePanel_Click"/>
          <Button x:Name="LangToggleBtn" Content="{ext:Loc language}" FontSize="11" Padding="6,3" Width="36" IsVisible="False"
                  ToolTip.Tip="{ext:Loc tip.lang.toggle}" Click="LangToggle_Click"/>
          <Button x:Name="GpuToggleBtn" Content="GPU" FontSize="11" Padding="8,3" IsVisible="False"
                  ToolTip.Tip="{ext:Loc tip.gpu.toggle}" Click="GpuToggle_Click"/>
          <Button x:Name="ThemeToggleBtn" Content="🌙" FontSize="14" Padding="6,2" IsVisible="False"
                  ToolTip.Tip="{ext:Loc tip.theme.toggle}" Click="ThemeToggle_Click"/>
        </StackPanel>

        <!-- Row 1: 保持目录结构 + 外部工具 + SIMD 开关（路径输入已上移 Row 0） -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
          <CheckBox x:Name="PreserveInputStructure" Content="{ext:Loc keep.dir.structure}" VerticalAlignment="Center" Margin="4,0,0,0"/>
          <Separator Width="16" Background="Transparent"/>
          <Button x:Name="ToggleToolsBtn" Content="{ext:Loc external.tools}" FontSize="11" Padding="6,2"
                  ToolTip.Tip="{ext:Loc tip.tools.toggle}" Click="ToggleToolsPanel_Click"/>
          <Border x:Name="ToolsCompactPanel" CornerRadius="3" Padding="6,2"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  IsVisible="False">
            <StackPanel x:Name="ToolsStatusBar" Orientation="Horizontal" Spacing="10"/>
          </Border>
          <Button Content="{ext:Loc redetect}" Click="RedetectTools_Click" Padding="4,2" FontSize="11"
                  ToolTip.Tip="{ext:Loc tip.redetect}"/>
          <CheckBox x:Name="AutoUseSimdCheck" Content="{ext:Loc simd.optimization}" VerticalAlignment="Center" FontSize="11"
                    ToolTip.Tip="{ext:Loc tip.simd}"/>
        </StackPanel>

        <!-- Row 2-3: 展开的外部工具详情（3 列水平布局） -->
        <StackPanel x:Name="ToolsDetailPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="False">
          <Grid ColumnDefinitions="*,8,*,8,*,8,*" Margin="0,4,0,0">
            <!-- 列 1: JXL 参考库 -->
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{ext:Loc jxl.reference.lib}" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="JxlLibDirBox" Width="160" VerticalAlignment="Center" FontSize="11"
                         PlaceholderText="{ext:Loc ph.autodetect.dir}"/>
                <Button Content="{ext:Loc btn.jxl.browse}" Click="BrowseJxlLibDir_Click" Padding="4,2" FontSize="10"/>
                <Button Content="{ext:Loc btn.clear}" Click="ClearJxlLibDir_Click" Padding="4,2" FontSize="10"
                        ToolTip.Tip="{ext:Loc tip.clear.path}"/>
              </StackPanel>
              <StackPanel x:Name="JxlToolsStatus" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"/>
            </StackPanel>
            <Separator Grid.Column="1" Width="4" Background="Transparent"/>
            <!-- 列 2: exiftool -->
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{ext:Loc exiftool.label}" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="ExifToolPathBox" Width="160" VerticalAlignment="Center" FontSize="11"
                         PlaceholderText="{ext:Loc ph.autodetect.exiftool}"/>
                <Button Content="{ext:Loc btn.jxl.browse}" Click="BrowseExifTool_Click" Padding="4,2" FontSize="10"/>
                <Button Content="{ext:Loc btn.clear}" Click="ClearExifToolPath_Click" Padding="4,2" FontSize="10"
                        ToolTip.Tip="{ext:Loc tip.clear.path}"/>
              </StackPanel>
              <StackPanel x:Name="ExifToolToolsStatus" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"/>
            </StackPanel>
            <Separator Grid.Column="3" Width="4" Background="Transparent"/>
            <!-- 列 3: artifacts -->
            <StackPanel Grid.Column="4" Spacing="4">
              <TextBlock Text="{ext:Loc artifacts.label}" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="ArtifactsDirBox" Width="160" VerticalAlignment="Center" FontSize="11"
                         PlaceholderText="{ext:Loc ph.autodetect.dir}"/>
                <Button Content="{ext:Loc btn.jxl.browse}" Click="BrowseArtifactsDir_Click" Padding="4,2" FontSize="10"/>
                <Button Content="{ext:Loc btn.clear}" Click="ClearArtifactsDir_Click" Padding="4,2" FontSize="10"
                        ToolTip.Tip="{ext:Loc tip.clear.path}"/>
              </StackPanel>
              <StackPanel x:Name="ArtifactsToolsStatus" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                          ToolTip.Tip="{ext:Loc tip.artifacts.dir}"/>
            </StackPanel>
            <Separator Grid.Column="5" Width="4" Background="Transparent"/>
            <!-- 列 4: Photoshop ACR 验证 -->
            <StackPanel Grid.Column="6" Spacing="4">
              <TextBlock Text="{ext:Loc label.ps.verify}" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Photoshop" FontSize="10" VerticalAlignment="Center"/>
                <TextBox x:Name="PhotoshopPathBox" Width="160" VerticalAlignment="Center" FontSize="11"
                         PlaceholderText="{ext:Loc ph.autodetect}"/>
                <Button Content="{ext:Loc btn.jxl.browse}" Click="BrowsePhotoshop_Click" Padding="4,2" FontSize="10"/>
                <Button Content="{ext:Loc btn.clear}" Click="ClearPhotoshopPath_Click" Padding="4,2" FontSize="10"
                        ToolTip.Tip="{ext:Loc tip.clear.path.restore}"/>
              </StackPanel>
              <StackPanel x:Name="PsToolsStatus" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                          ToolTip.Tip="{ext:Loc tip.ps.verify}"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Row 4: 缓存目录（折叠，默认隐藏） -->
        <StackPanel x:Name="CachePanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    IsVisible="False" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <TextBlock Text="{ext:Loc cache.dir}" VerticalAlignment="Center" FontSize="12"
                     ToolTip.Tip="{ext:Loc tip.cache.dir}"/>
          <TextBox x:Name="CacheDirBox" Width="280" VerticalAlignment="Center" FontSize="11"
                   PlaceholderText="{ext:Loc ph.cache.auto}"/>
          <Button Content="{ext:Loc browse}" Click="BrowseCacheDir_Click" Padding="6,3" FontSize="11"/>
          <Button Content="{ext:Loc btn.clear}" Click="ClearCacheDir_Click" Padding="6,3" FontSize="11"
                  ToolTip.Tip="{ext:Loc tip.cache.restore}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体两栏布局 -->
    <!-- 左栏 276 → 300（2026-09-16）：内容可用宽从 ~236 提到 ~260，缓解多处"恰好用满"的临界
         （如质量滑块曾 170+8+58=236 正好卡满，一出现纵向滚动条即溢出）。窗口默认宽 1100
         ⇒ 右侧预览仍有约 800px，观感不失衡；最小宽 900 时预览 600px 也够用。 -->
    <Grid ColumnDefinitions="300,*" RowDefinitions="*" Margin="0,4,0,0">
      <!-- ============ 左侧：参数控制面板（卡片容器） ============ -->
      <Border Grid.Column="0" Margin="12,0,0,8" Padding="0"
              CornerRadius="10" BoxShadow="0 2 12 0 #10000000"
              Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
      <ScrollViewer>
        <StackPanel Margin="14" Spacing="8">
          <TextBlock Text="{ext:Loc parameter.panel}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" VerticalAlignment="Center"/>
          <WrapPanel HorizontalAlignment="Stretch" Margin="0,0,0,0">
            <Button x:Name="PresetManagerBtn" Content="{ext:Loc preset}" FontSize="12" Padding="8,3"
                    ToolTip.Tip="{ext:Loc tip.preset.mgr}"
                    Click="OpenPresetManager_Click" Margin="0,0,8,0"/>
            <Button x:Name="SimpleModeEntryBtn" Content="{ext:Loc simple.mode}" FontSize="12"
                    Padding="10,5"
                    ToolTip.Tip="{ext:Loc tip.simple.mode}"
                    Click="EnterSimpleMode_Click"/>
          </WrapPanel>
          <TextBlock Text="{ext:Loc conversion.mode}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          <!-- 模式下拉: 静态图片 / 动图 / RAW 图片 -->
          <ComboBox x:Name="ConversionModeCombo" SelectedIndex="0"
                    SelectionChanged="ConversionMode_SelectionChanged">
            <sys:String>🖼 静态图片模式</sys:String>
            <sys:String>🎞 动图模式</sys:String>
            <sys:String>📷 RAW 图片</sys:String>
          </ComboBox>
          <TextBlock Text="{ext:Loc output.format}" Margin="0,4,0,0"/>
          <ComboBox x:Name="FormatCombo" SelectedIndex="0"
                    SelectionChanged="FormatCombo_SelectionChanged">
            <sys:String>JPEG</sys:String>
            <sys:String>PNG</sys:String>
            <sys:String>WebP</sys:String>
            <sys:String>AVIF</sys:String>
            <sys:String>JPEG XL</sys:String>
            <sys:String>TIFF</sys:String>
          </ComboBox>
          <!-- 动图参数面板 -->
          <StackPanel x:Name="AnimationPanel" IsVisible="False" Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="{ext:Loc animation.params}" FontSize="13" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{ext:Loc fps}" FontSize="11"/>
                <TextBox x:Name="AnimationFpsBox" Text="" Width="60" FontSize="13" VerticalAlignment="Center"
                         PlaceholderText="auto"/>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{ext:Loc loop.count}" FontSize="11"/>
                <TextBox x:Name="AnimationLoopBox" Text="" Width="60" FontSize="13" VerticalAlignment="Center"
                         PlaceholderText="auto"/>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{ext:Loc scale.width}" FontSize="11"/>
                <TextBox x:Name="AnimationScaleWBox" Text="" Width="60" FontSize="13" VerticalAlignment="Center"
                         PlaceholderText="auto"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{ext:Loc animation.hint}" FontSize="10"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap"/>
            <!-- 视频时长限制（仅视频输入时生效） -->
            <StackPanel x:Name="AnimationDurationPanel" Spacing="2" IsVisible="False">
              <TextBlock Text="{ext:Loc max.duration}" FontSize="11"/>
              <TextBox x:Name="AnimationDurationBox" Text="" Width="60" FontSize="13" VerticalAlignment="Center"
                       PlaceholderText="{ext:Loc ph.no.limit}"/>
              <TextBlock Text="{ext:Loc animation.duration.hint}" FontSize="10"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
          <!-- RAW/DNG 专属选项面板 -->
          <StackPanel x:Name="RawPanel" IsVisible="False" Spacing="4" Margin="0,4,0,0">
            <TextBlock x:Name="RawEngineStatus" Text="{ext:Loc dng.status.detecting}" FontSize="11"
                       TextWrapping="Wrap"/>
            <!-- ⚠⚠ 2026-09-20：**DNG 输出专属选项**统一放进本面板，
                 可见性 = 「RAW 模式 **且** 输出格式 = dng」。
                 原先它们直接放在 RawPanel 里 ⇒ 用户选「RAW → jpg/avif」时这些选项**仍然显示**，
                 会让人以为设置生效，实际对非 DNG 输出**完全无效** ⇒ 「UI 与真实不符」。 -->
            <StackPanel x:Name="DngOptionsPanel" IsVisible="False" Spacing="4">
            <!-- ── DNG 压缩方式 ── -->
            <TextBlock Text="{ext:Loc dng.compression}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
            <!-- 选项改由 C# 的 FillComboByLoc 填充：<sys:String> 是元素内容，
                 {ext:Loc} 在那里不生效 ⇒ 选项无法随语言切换 -->
            <ComboBox x:Name="DngCompressionCombo" SelectedIndex="1"
                      SelectionChanged="DngCompression_SelectionChanged"/>
            <!-- JXL 质量 (仅 JXL 压缩时显示) -->
            <StackPanel x:Name="DngJxlQualityPanel" IsVisible="True" Spacing="2" Margin="0,4,0,0">
              <TextBlock Text="{ext:Loc dng.jxl.quality}" FontSize="11"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Slider x:Name="DngJxlQualitySlider" Minimum="0" Maximum="100" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" Width="150"
                        VerticalAlignment="Center"/>
                <TextBox x:Name="DngJxlQualityBox" Text="0" Width="46" FontSize="13"
                         VerticalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <!-- JXL 编码参数 (仅 JXL 压缩时显示) -->
            <StackPanel x:Name="DngJxlAdvancedPanel" IsVisible="True" Spacing="2" Margin="0,4,0,0">
              <TextBlock Text="{ext:Loc dng.jxl.effort}" FontSize="11"/>
              <NumericUpDown x:Name="DngJxlEffortBox" Value="7" Minimum="1" Maximum="9" Increment="1"/>
              <TextBlock Text="{ext:Loc dng.jxl.decode}" FontSize="11" Margin="0,4,0,0"/>
              <NumericUpDown x:Name="DngJxlDecodeSpeedBox" Value="1" Minimum="1" Maximum="4" Increment="1"/>
            </StackPanel>
            <!-- ── DNG 布局: 保留 CFA / 线性 ── -->
            <TextBlock Text="{ext:Loc dng.layout}" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
            <ComboBox x:Name="DngLinearCombo" SelectedIndex="0"/>
            <!-- 2026-09-21: hint for "Linear DNG" applicability.
                 dngtool rejects -linear for Bayer input ("-linear only applies to linear/demosaiced input"),
                 but the UI listed Linear alongside Keep CFA with NO hint at all
                 => user selects it and fails at runtime => UI vs. real behaviour mismatch.
                 Shown only while Linear is selected (see MainWindow.xaml.cs). -->
            <TextBlock x:Name="DngLinearHint" Text="{ext:Loc dng.linear.hint}"
                       IsVisible="False" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <!-- ── 位深 ── -->
            <TextBlock Text="{ext:Loc dng.bitdepth}" FontSize="11" Margin="0,4,0,0"/>
            <ComboBox x:Name="DngBitDepthCombo" SelectedIndex="1"/>
            <!-- ── 高光模式 (LibRaw -H) ── -->
            <TextBlock Text="{ext:Loc dng.highlight}" FontSize="11" Margin="0,4,0,0"/>
            <ComboBox x:Name="DngHighlightCombo" SelectedIndex="1"/>
            <!-- 2026-09-21: measured - CFA-preserving DNG output is UNAFFECTED by highlight mode
                 (all three modes produce byte-identical files); it only applies to the
                 demosaic/linear path. Stating this avoids "UI vs. real behaviour" mismatch. -->
            <TextBlock Text="{ext:Loc dng.highlight.hint}" FontSize="10"
                       TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Text="{ext:Loc dng.note.sensor}" FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Text="{ext:Loc dng.note.formats}" FontSize="10"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Text="{ext:Loc dng.note.input}" FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
          </StackPanel>
          <!-- ============ 静态图片/动图通用选项（RAW 模式下整体隐藏） ============ -->
          <StackPanel x:Name="StillOptionsPanel" Spacing="8">
          <TextBlock Text="{ext:Loc encoder}" Margin="0,4,0,0"/>
          <ComboBox x:Name="EncoderCombo"/>
          <!-- GPU 硬件编码器状态警告 -->
          <Border x:Name="GpuEncoderWarning" IsVisible="False"
                  CornerRadius="6" Padding="10,7" Margin="0,6,0,0">
            <StackPanel Spacing="4">
              <TextBlock x:Name="GpuEncoderWarningText" FontSize="11"
                         TextWrapping="Wrap" Foreground="#333333"/>
              <TextBlock x:Name="GpuEncoderWarningHint" FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         Text="{ext:Loc gpu.encoder.warning}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{ext:Loc quality}" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- 2026-09-16：左栏加宽到 300（内容区 ~260）后，不再需要为"236 临界"留余量，
                 恢复原来的 170（滑块手感更好）。170+8+58=236 < 260，即使出现纵向滚动条也不溢出。 -->
            <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" Value="92"
                    TickFrequency="1" IsSnapToTickEnabled="True" Width="170" />
            <TextBox x:Name="QualityBox" Text="92" Width="58" FontSize="13"
                     VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="QualityValue" Text="质量: 75"/>
          <!-- 基本色彩参数：色度采样 / 位深（色彩空间已移至高级面板） -->
          <Border CornerRadius="4" Padding="8,6" Margin="0,4,0,0"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="6">
              <TextBlock Text="{ext:Loc chroma.subsampling}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <ComboBox x:Name="ChromaCombo">
                <sys:String>auto</sys:String>
                <sys:String>4:4:4</sys:String>
                <sys:String>4:2:2</sys:String>
                <sys:String>4:2:0</sys:String>
              </ComboBox>
              <TextBlock Text="{ext:Loc bit.depth}"/>
              <ComboBox x:Name="BitDepthCombo">
                <sys:String>auto</sys:String>
                <sys:String>8</sys:String>
                <sys:String>10</sys:String>
                <sys:String>12</sys:String>
                <sys:String>16</sys:String>
              </ComboBox>
            </StackPanel>
          </Border>
          <CheckBox x:Name="UseAdvancedColor" Content="{ext:Loc advanced.color}" IsCheckedChanged="UseAdvancedColor_IsCheckedChanged"/>
          <StackPanel x:Name="AdvancedColorPanel" IsVisible="False" Spacing="6">
            <!-- ── 色彩空间快速选择 ── -->
            <TextBlock Text="{ext:Loc color.space.quick}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <ComboBox x:Name="ColorSpaceCombo" SelectionChanged="ColorSpaceCombo_SelectionChanged">
              <sys:String>auto</sys:String>
              <sys:String>sRGB</sys:String>
              <sys:String>BT.709</sys:String>
              <sys:String>Display P3</sys:String>
              <sys:String>P3 PQ</sys:String>
              <sys:String>BT.2020 PQ</sys:String>
              <sys:String>BT.2020 HLG</sys:String>
            </ComboBox>

            <!-- ── 色域映射（GMO）：源色域超出目标时压缩（去饱和）而非硬裁切 ──
                 默认不勾选 ⇒ 与历史行为逐字节相同（钳位）；未越界的像素即使勾选也逐字节不变。 -->
            <CheckBox x:Name="ColorGamutMapCheck" Content="{ext:Loc gamut.map.enable}"
                      Margin="0,2,0,0" FontSize="11"
                      ToolTip.Tip="{ext:Loc tip.gamut.map}"
                      IsCheckedChanged="ColorGamutMap_Changed"/>

            <!-- ── RAW 输出色域模式（三档；仅对 RAW 输入生效）──
                 取值用 ASCII 记号（rec2020 / auto / rec709）：XAML 硬编码中文有**硬上限**
                 （`_probe-cjk-hardcode-scan` 的 BASE_XAML = 13，不得增加）⇒ 文案一律走 {ext:Loc}。 -->
            <TextBlock Text="{ext:Loc raw.target.label}" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <ComboBox x:Name="RawColorTargetCombo" FontSize="11"
                      ToolTip.Tip="{ext:Loc tip.raw.target}">
              <sys:String>rec2020</sys:String>
              <sys:String>auto</sys:String>
              <sys:String>rec709</sys:String>
            </ComboBox>

            <!-- ── 精确色彩参数 ── -->
            <TextBlock Text="{ext:Loc color.primaries}" Margin="0,6,0,0"/>
            <ComboBox x:Name="ColorPrimariesCombo">
              <!-- ⚠ 首项 `auto` = **不指定**（模式 1 默认；提交时映射为 null）。2026-10-04 设计裁定：
                   模式 1 允许 auto（走自动默认）；模式 2/3/4 必须手动指定（见 UpdateAdvancedColorValidation）。 -->
              <sys:String>auto</sys:String>
              <sys:String>bt709</sys:String>
              <sys:String>bt2020</sys:String>
              <sys:String>smpte432</sys:String>
            </ComboBox>
            <TextBlock Text="{ext:Loc color.transfer}"/>
            <ComboBox x:Name="ColorTrcCombo">
              <!-- ⚠ 首项 `auto` = 不指定（模式 1 默认；提交时映射为 null）。 -->
              <sys:String>auto</sys:String>
              <sys:String>iec61966-2-1</sys:String>
              <sys:String>bt709</sys:String>
              <sys:String>smpte2084</sys:String>
              <sys:String>arib-std-b67</sys:String>
              <sys:String>linear</sys:String>
            </ComboBox>
            <TextBlock Text="{ext:Loc color.matrix}"/>
            <ComboBox x:Name="ColorMatrixCombo">
              <!-- ⚠ 首项 `auto` = 不指定（模式 1 默认；提交时映射为 null）。 -->
              <sys:String>auto</sys:String>
              <!-- ⚠ 只能是**在本管线的两个角色里都真的可用**的矩阵（实测，2026-09-16）：
                   角色①「输入声明」= `-i` 前的 `-colorspace`，需 swscale 能按该矩阵做像素转换；
                   角色②「输出标注」= `-i` 后的 `-colorspace`，需目标编码器/容器能承载。
                   已移除 `bt2020c` / `ycgco`：两个角色**都失败** ——
                     实测 `-colorspace bt2020c|ycgco` 令 swscale 报
                     `Impossible to convert between the formats supported by the filter` ⇒ 退出码 -40、零产物；
                     而作为输出标注时 mjpeg/libwebp/libaom 也一律拒绝。
                   已移除 `bt2020ncl` / `bt2020cl` / `bt2020` / `smpte432` / `smpte431`（历史脏值，两侧都不认）。
                   新增 `bt470bg`（BT.601-625）/ `smpte170m`（BT.601-525）：对老标清素材有实际意义，
                   且实测两个角色都可用。`gbr` = RGB 矩阵（ffmpeg 侧自动映射为 `rgb`）。
                   若旧预设仍带已移除的值，NormalizeMatrixToken 会归一，不会失败。 -->
              <sys:String>bt709</sys:String>
              <sys:String>bt2020nc</sys:String>
              <sys:String>bt470bg</sys:String>
              <sys:String>smpte170m</sys:String>
              <sys:String>gbr</sys:String>
            </ComboBox>

            <!-- tonemap 曲线不再暴露给用户：内部固定 hable（HDR→SDR） -->
            
            <!-- 色彩范围（TV/PC）: 仅 YUV 输出格式支持（AVIF），不支持的格式整组隐藏（2026-08-16）
                 auto=跟随输入范围（RGB/yuvj→pc，yuv limited→tv） -->
            <TextBlock x:Name="ColorRangeLabel" Text="{ext:Loc color.range}" ToolTip.Tip="{ext:Loc tip.color.range}"/>
            <ComboBox x:Name="ColorRangeCombo"/>
            
            <!-- CICP 标记（始终启用以保证准确色彩） -->
            <TextBlock Text="{ext:Loc cicp.always.on}" FontSize="10"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       ToolTip.Tip="{ext:Loc tip.cicp}"/>
            
            <!-- ── 冲突提示 ── -->
            <TextBlock x:Name="ColorConflictLabel" Text="" FontSize="10" 
                       Foreground="Orange" TextWrapping="Wrap" IsVisible="False"/>
            
            <!-- ═══════════════ ICC 色彩管理（统一面板，CICP 始终启用）═══════════════ -->
            <Border CornerRadius="4" Padding="8,6" Margin="0,6,0,0"
                    Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{ext:Loc icc.color.management}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Content="?" Width="18" Height="18" FontSize="10" Padding="0"
                          ToolTip.Tip="{ext:Loc tip.icc.modes}"
                          Click="IccHelp_Click"/>
                </StackPanel>
                
                  <!-- 色彩策略选择（4 种；按钮显示简写，悬浮显示完整说明） -->
                <StackPanel Spacing="2">
                  <RadioButton x:Name="IccModeNone" GroupName="IccMode"
                               Content="{ext:Loc color.strategy.recommended}" IsChecked="True"
                               ToolTip.Tip="{ext:Loc color.strategy.recommended.tip}"
                               IsCheckedChanged="IccMode_Changed"/>
                  <RadioButton x:Name="IccModeCarry" GroupName="IccMode"
                               Content="{ext:Loc color.strategy.carry}"
                               ToolTip.Tip="{ext:Loc color.strategy.carry.tip}"
                               IsCheckedChanged="IccMode_Changed"/>
                  <RadioButton x:Name="IccModeBake" GroupName="IccMode"
                               Content="{ext:Loc color.strategy.cicponly}"
                               ToolTip.Tip="{ext:Loc color.strategy.cicponly.tip}"
                               IsCheckedChanged="IccMode_Changed"/>
                  <RadioButton x:Name="IccModeBakeOnly" GroupName="IccMode"
                               Content="{ext:Loc color.strategy.manual}"
                               ToolTip.Tip="{ext:Loc color.strategy.manual.tip}"
                               IsCheckedChanged="IccMode_Changed"/>
                </StackPanel>

                <!-- HDR 实现模式（用户-facing 二选一）：GainMap（SDR 底图 + 增益图）| 传统（原生 PQ/HLG）。
                     ⚠ 可见性由 `UpdateOptionAvailability` 按**容器能力**给（JPEG 族与 AVIF），XAML 只给初始隐藏；
                       ItemsSource 由 `FillComboByLoc` 在代码侧按本地化键填充。 -->
                <ComboBox x:Name="HdrModeCombo" IsVisible="False" Margin="0,6,0,0" FontSize="11"
                          ToolTip.Tip="{ext:Loc tip.gainmap.enable}"
                          SelectionChanged="HdrMode_Changed"/>
                
                <!-- 源色彩空间不再由用户手动指定：软件自动根据 CICP+ICC 探测判断（阶段3.6）。烘焙目标子面板已废弃移除。 -->
                
                <!-- 标准 ICC 预览提示 -->
                <StackPanel x:Name="IccFilePanel" IsVisible="False" Spacing="4">
                  <TextBlock x:Name="IccInfoLabel" Text="" FontSize="10"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <CheckBox x:Name="UseAdvancedCodec" Content="{ext:Loc advanced.codec}" Margin="0,6,0,0" 
                    IsCheckedChanged="UseAdvancedCodec_IsCheckedChanged"/>
          <StackPanel x:Name="AdvancedCodecPanel" IsVisible="False" Margin="0,4,0,0" Spacing="6">
            <!-- PNG -->
            <StackPanel x:Name="PngCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc prediction.mode}" FontSize="11"/>
              <ComboBox x:Name="PngPredCombo" SelectedIndex="4"/>
              <TextBlock Text="{ext:Loc png.dpi}" Margin="0,6,0,0" FontSize="11"/>
              <!-- ⚠ 同 496 行：72px 数值框 + 约 200px 提示文本 ≈ 276px > 面板可用 236px，
                   横向 StackPanel 不换行也不滚动 ⇒ 提示被裁。拆成「数值框 + 独立提示行」。 -->
              <NumericUpDown x:Name="PngDpiBox" Value="0" Minimum="0" Maximum="2400" Increment="72" MinWidth="88" HorizontalAlignment="Left"/>
              <TextBlock Text="{ext:Loc png.dpi.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <!-- GIF 动图 -->
            <StackPanel x:Name="GifCodecPanel" IsVisible="False" Spacing="4">
              <CheckBox x:Name="GifPaletteCheck" Content="{ext:Loc gif.palette}" IsChecked="True"/>
              <CheckBox x:Name="GifDitherCheck" Content="{ext:Loc gif.dither}" IsChecked="True"/>
            </StackPanel>
            <!-- APNG -->
            <StackPanel x:Name="ApngCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc apng.note}" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <!-- WebP -->
            <StackPanel x:Name="WebpCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc webp.preset}"/>
              <ComboBox x:Name="WebpPresetCombo" SelectedIndex="2">
                <sys:String>none</sys:String><sys:String>default</sys:String><sys:String>picture</sys:String>
                <sys:String>photo</sys:String><sys:String>drawing</sys:String><sys:String>icon</sys:String>
                <sys:String>text</sys:String>
              </ComboBox>
              <StackPanel x:Name="WebpLosslessPanel" Spacing="4">
                <TextBlock Text="{ext:Loc webp.lossless.level}" Margin="0,4,0,0"/>
                <NumericUpDown x:Name="WebpCompressionBox" Value="4" Minimum="0" Maximum="6"/>
                <TextBlock Text="{ext:Loc webp.lossless.hint}" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </StackPanel>
            </StackPanel>
            <!-- AVIF -->
            <StackPanel x:Name="AvifCodecPanel" IsVisible="False" Spacing="4">
              <!-- ── libaom-av1 选项 ── -->
              <StackPanel x:Name="LibaomAvifPanel" Spacing="4">
                <TextBlock Text="{ext:Loc avif.cpu.used}" FontSize="11"/>
                <NumericUpDown x:Name="AvifCpuUsedBox" Value="5" Minimum="0" Maximum="8"/>
                <TextBlock Text="{ext:Loc avif.tune}" Margin="0,4,0,0" FontSize="11"/>
                <ComboBox x:Name="AvifTuneCombo" SelectedIndex="4"/>
                <TextBlock Text="{ext:Loc avif.aq.mode}" Margin="0,4,0,0" FontSize="11"/>
                <ComboBox x:Name="AvifAqModeCombo" SelectedIndex="0"/>
                <TextBlock Text="{ext:Loc avif.adv.filter}" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="AvifCdefCheck" Content="{ext:Loc avif.cdef}" IsChecked="True"/>
                <CheckBox x:Name="AvifIntrabcCheck" Content="{ext:Loc avif.intrabc}" IsChecked="True"/>
                <TextBlock Text="{ext:Loc avif.film.grain}" Margin="0,4,0,0" FontSize="11"/>
                <!-- ⚠ 原写法把 60px 数值框与约 270px 的提示文本塞进**横向 StackPanel**（总宽 ≈336px
                     ≫ 面板可用 236px），而横向 StackPanel 既不换行也不滚动 ⇒ 提示被裁掉大半。
                     改为「数值框一行 + 提示独立一行且允许折行」。 -->
                <NumericUpDown x:Name="AvifDenoiseBox" Value="0" Minimum="0" Maximum="50" MinWidth="80" HorizontalAlignment="Left"/>
                <TextBlock Text="{ext:Loc avif.denoise.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="AvifStillPictureCheck" Content="{ext:Loc avif.still.picture}" IsChecked="True"/>
                <CheckBox x:Name="AvifRowMtCheck" Content="{ext:Loc avif.row.mt}" IsChecked="True" Margin="0,4,0,0"/>
              </StackPanel>
              <!-- ── SVT-AV1 选项 ── -->
              <StackPanel x:Name="SvtAvifPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc svt.preset}" FontSize="11"/>
                <NumericUpDown x:Name="SvtPresetBox" Value="7" Minimum="0" Maximum="13"/>
                <TextBlock Text="{ext:Loc svt.tune}" Margin="0,4,0,0" FontSize="11"/>
                <ComboBox x:Name="SvtTuneCombo" SelectedIndex="1"/>
                <!-- libsvtav1 没有 still-picture 这个 AVOption（实测 `-svtav1-params still-picture=1`
                     报 Error parsing option、退出码 127），面板上原先那只「静态图片模式」复选框
                     全仓无消费方 ⇒ 已删除（A-11）；实发的 -still-picture 只来自 libaom 面板那只。 -->
              </StackPanel>
              <!-- ── NVENC 硬件编码器选项 ── -->
              <StackPanel x:Name="NvencAvifPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc hw.quality.preset}" FontSize="11"/>
                <ComboBox x:Name="NvencPresetCombo" SelectedIndex="3"/>
                <TextBlock Text="{ext:Loc nvenc.aq.strength}" Margin="0,4,0,0" FontSize="11"/>
                <!-- ⚠ 同 496 行：60px 数值框 + 约 220px 提示文本 ≈ 286px > 面板可用 236px ⇒ 提示被裁。 -->
                <!-- 下限 1：官方区间是 [1,15]（实测 `-h encoder=av1_nvenc` 打印 from 1 to 15、default 8），
                     传 0 不是「关闭 AQ」而是硬失败（实测 Value 0.000000 for parameter aq-strength
                     out of range [1 - 15]、退出码 127）。要关 AQ 请取消下方 Spatial AQ 勾选
                     （实测不勾 spatial-aq 时 aq-strength 完全不参与：1 / 15 / 省略三态产物逐字节相同）。 -->
                <NumericUpDown x:Name="AvifNvencAqBox" Value="8" Minimum="1" Maximum="15" MinWidth="80" HorizontalAlignment="Left"/>
                <TextBlock Text="{ext:Loc avif.aq.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="AvifNvencSpatialAqCheck" Content="{ext:Loc avif.spatial.aq}" IsChecked="True"/>
                <!-- ⚠ 本面板**刻意不接** hw.hint（"硬件编码器仅支持预设调节，质量由上方滑块控制"）：
                     上面有 -aq-strength / -spatial-aq 两个质量相关控件 ⇒ 那句"仅支持预设调节"在此是假话；
                     且本面板的提示位已被 avif.aq.hint 占用。其余 3 个硬件面板（QSV/VAAPI/AMF）均已接线。 -->
              </StackPanel>
              <!-- ── QSV 硬件编码器选项 ── -->
              <StackPanel x:Name="QsvAvifPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc hw.quality.preset}" FontSize="11"/>
                <ComboBox x:Name="QsvPresetCombo" SelectedIndex="3"/>
                <TextBlock Text="{ext:Loc hw.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="AvifQsvLowPowerCheck" Content="{ext:Loc qsv.low.power}" Margin="0,4,0,0"/>
              </StackPanel>
              <!-- ── VAAPI 硬件编码器选项 ── -->
              <StackPanel x:Name="VaapiAvifPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc hw.quality.preset}" FontSize="11"/>
                <ComboBox x:Name="VaapiPresetCombo" SelectedIndex="3"/>
                <TextBlock Text="{ext:Loc hw.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="AvifVaapiLowPowerCheck" Content="{ext:Loc vaapi.low.power}" Margin="0,4,0,0"/>
              </StackPanel>
              <!-- ── AMF 硬件编码器选项 ── -->
              <StackPanel x:Name="AmfAvifPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc hw.quality.preset}" FontSize="11"/>
                <ComboBox x:Name="AmfPresetCombo" SelectedIndex="1"/>
                <TextBlock Text="{ext:Loc hw.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </StackPanel>
            </StackPanel>
            <!-- JPEG XL -->
            <StackPanel x:Name="JxlCodecPanel" IsVisible="False" Spacing="4">
              <!-- FFmpeg libjxl -->
              <StackPanel x:Name="JxlFfmpegPanel" IsVisible="True" Spacing="4">
                <TextBlock Text="{ext:Loc jxl.effort}"/>
                <NumericUpDown x:Name="JxlEffortBox" Value="7" Minimum="1" Maximum="9"/>
                <CheckBox x:Name="JxlModularCheck" Content="{ext:Loc jxl.modular}"/>
              </StackPanel>
              <!-- cjxl 外部工具 -->
              <StackPanel x:Name="JxlCjxlPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="{ext:Loc jxl.effort}"/>
                <NumericUpDown x:Name="CjxlEffortBox" Value="7" Minimum="1" Maximum="9"/>
                <CheckBox x:Name="CjxlProgressiveCheck" Content="{ext:Loc jxl.progressive}" Margin="0,4,0,0"/>
                <CheckBox x:Name="CjxlAutoPhotonNoiseCheck" Margin="0,4,0,0" ToolTip.Tip="{ext:Loc tip.photon.auto}">
                  <TextBlock Text="{ext:Loc jxl.photon.auto}" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="{ext:Loc jxl.photon.iso}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <NumericUpDown x:Name="CjxlPhotonNoiseBox" Value="0" Minimum="0" Maximum="3200" Increment="100" MinWidth="96" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{ext:Loc jxl.photon.hint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </StackPanel>
              <!-- Ultra HDR (Gain Map) JPEG → JXL 处理策略 -->
              <CheckBox x:Name="JxlPreserveUltrahdrCheck"
                        Content="{ext:Loc jxl.preserve.ultrahdr}"
                        IsChecked="True" Margin="0,4,0,0" FontSize="11"/>
            </StackPanel>
            <!-- JPEG → JPEG XL 无损快速重封装（jbrd）：JPEG 与 JPEG XL 两处**共用这一只控件** -->
            <!-- ⚠ 必须位于 JxlCjxlPanel / JpegCodecPanel 之外（与下面 JpegGainMapPanel 同一条理由）：
                 嵌进任一只按格式切换的面板，另一格就看不见它 ⇒ 只能再放第二只，而两只控件
                 = 两个真值，正是本仓反复修过的形状。可见性由 UpdateCodecPanelVisibility 统一开合。 -->
            <StackPanel x:Name="JxlLosslessJpegPanel" IsVisible="False" Spacing="2">
              <CheckBox x:Name="JxlLosslessJpegCheck" IsChecked="True" ToolTip.Tip="{ext:Loc tip.jxl.lossless.jpeg}">
                <TextBlock Text="{ext:Loc jxl.lossless.jpeg}" TextWrapping="Wrap"/>
              </CheckBox>
              <TextBlock Text="{ext:Loc jxl.lossless.jpeg.hint}" FontSize="10" TextWrapping="Wrap"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <!-- Gain Map (Ultra HDR) 选项 — 任意 JPEG 编码器 (mjpeg/cjpegli) 公共选项 -->
            <!-- ⚠️ 必须位于 JpegCodecPanel / JpegliCodecPanel 之外: cjpegli 后端显示
                 JpegliCodecPanel, 若嵌套在 JpegCodecPanel 内会被父容器隐藏导致不可见 -->
            <Border x:Name="JpegGainMapPanel" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
              <StackPanel x:Name="JpegGainMapOptions" Spacing="6">
                <TextBlock Text="{ext:Loc gainmap.title}" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{ext:Loc gainmap.note}" FontSize="9"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                <!-- 增益图类型：灰度 / RGB -->
                <TextBlock Text="{ext:Loc gainmap.type}" FontSize="11" Margin="0,2,0,0"/>
                <ComboBox x:Name="JpegGainMapTypeCombo" SelectedIndex="0" FontSize="11"/>
                <!-- 底图色域：sRGB SDR 底（默认）/ Rec.2020 SDR 底（广色域）-->
                <TextBlock Text="{ext:Loc gainmap.base.gamut}" FontSize="11" Margin="0,2,0,0"/>
                <ComboBox x:Name="JpegGainMapBaseCombo" SelectedIndex="0" FontSize="11"/>
                <TextBlock Text="{ext:Loc gainmap.base.note}" FontSize="9"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                <!-- 增益图质量：跟随主图 或 独立设置 -->
                <CheckBox x:Name="JpegGainMapFollowMainCheck"
                          Content="{ext:Loc gainmap.quality.follow}"
                          IsChecked="True" FontSize="11"
                          ToolTip.Tip="{ext:Loc tip.gainmap.quality.follow}"/>
                <StackPanel x:Name="JpegGainMapQualityPanel"
                            IsVisible="False" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{ext:Loc gainmap.quality}" VerticalAlignment="Center" Width="80" FontSize="11"/>
                  <Button x:Name="GainMapQualityDownBtn" Content="−"
                          Width="26" Height="24" FontSize="13" Padding="0"
                          ToolTip.Tip="{ext:Loc tip.gainmap.quality.down}"/>
                  <TextBox x:Name="JpegGainMapQualityBox" Text="75"
                           Width="42" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="12"/>
                  <Button x:Name="GainMapQualityUpBtn" Content="+"
                          Width="26" Height="24" FontSize="13" Padding="0"
                          ToolTip.Tip="{ext:Loc tip.gainmap.quality.up}"/>
                </StackPanel>
                <!-- 目标亮度：Slider + TextBox 联动 -->
                <TextBlock Text="{ext:Loc gainmap.target.nits}" FontSize="11" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Slider x:Name="JpegGainMapNitsSlider" Minimum="200" Maximum="10000"
                          TickFrequency="100" IsSnapToTickEnabled="True" Width="130"
                          VerticalAlignment="Center"/>
                  <TextBox x:Name="JpegGainMapNitsBox" Text="1000"
                           Width="54" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="12"/>
                  <TextBlock Text="nit" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <!-- 增益图分辨率 -->
                <TextBlock Text="{ext:Loc gainmap.res.title}" FontSize="11" Margin="0,4,0,0"/>
                <ComboBox x:Name="JpegGainMapDownsampleCombo" SelectedIndex="1" FontSize="11"/>
                <TextBlock Text="{ext:Loc gainmap.res.hint}" FontSize="9"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <!-- JPEG (FFmpeg mjpeg / libultrahdr) -->
            <StackPanel x:Name="JpegCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc jpeg.huffman}"/>
              <ComboBox x:Name="JpegHuffmanCombo" SelectedIndex="1">
                <sys:String>default</sys:String><sys:String>optimal</sys:String>
              </ComboBox>
              <TextBlock Text="{ext:Loc jpeg.dct}" Margin="0,4,0,0"/>
              <!-- A-20：ffmpeg mjpeg 的 -dct 没有 float（实测 -dct float ⇒ rc=127
                   「Undefined constant or missing '('」），留着它就是一条选了必失败的路径；
                   int / fastint 实测生效。历史预设或 CLI 若仍写 float，会原样透传给编码器
                   并响亮失败，不在这里静默改写。 -->
              <ComboBox x:Name="JpegDctCombo" SelectedIndex="0">
                <sys:String>auto</sys:String><sys:String>int</sys:String>
                <sys:String>fastint</sys:String>
              </ComboBox>
              <!-- JPEG 渐进: ffmpeg mjpeg 编码器不支持渐进输出（源码确认仅基线），
                   该值仅供 cjpegli/Gain Map 路径使用（QueueProcessor 转换），故保持隐藏 -->
              <TextBlock Text="{ext:Loc jpeg.progressive.mode}" Margin="0,4,0,0" IsVisible="False"/>
              <ComboBox x:Name="JpegProgressiveCombo" SelectedIndex="1" FontSize="11" IsVisible="False"/>
            </StackPanel>
            <!-- JPEG-LI (cjpegli) -->
            <StackPanel x:Name="JpegliCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc jpeg.chroma.subsampling}"/>
              <ComboBox x:Name="JpegliChromaCombo" SelectedIndex="0">
                <sys:String>auto</sys:String><sys:String>444</sys:String>
                <sys:String>422</sys:String><sys:String>420</sys:String><sys:String>440</sys:String>
              </ComboBox>
              <TextBlock Text="{ext:Loc jpeg.progressive.mode}" Margin="0,4,0,0"/>
              <ComboBox x:Name="JpegliProgressiveCombo" SelectedIndex="2"/>
              <CheckBox x:Name="JpegliOptimizeCheck" Content="{ext:Loc jpeg.optimize.huffman}" IsChecked="True" Margin="0,4,0,0"
                        ToolTip.Tip="{ext:Loc tip.jpeg.fixed.code}"/>
              <CheckBox x:Name="JpegliAdaptiveQuantCheck" Content="{ext:Loc jpeg.adaptive.quant}" IsChecked="True"
                        ToolTip.Tip="{ext:Loc tip.jpeg.noadaptive.quant}"/>
              <!-- 2026-08-16: 当前 cjpegli 版本仅支持 libjpeg 后端（jpeg_encoder/psnr 参数已移除），
                   后端选择与 PSNR 面板隐藏，避免误导用户 -->
              <TextBlock Text="{ext:Loc jpeg.encoder.backend}" Margin="0,4,0,0" IsVisible="False"/>
              <ComboBox x:Name="JpegliEncoderBackendCombo" SelectedIndex="0" IsVisible="False"/>
              <Border x:Name="JpegliPsnrPanel" IsVisible="False" CornerRadius="4" Padding="6,3" Margin="0,4,0,0"
                      BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
                <StackPanel Spacing="3">
                  <TextBlock Text="{ext:Loc jpeg.psnr.target}" FontSize="11"/>
                  <NumericUpDown x:Name="JpegliPsnrBox" Value="0" Minimum="0" Maximum="60" Increment="0.5" FontSize="11"/>
                  <TextBlock Text="{ext:Loc jpeg.psnr.hint}" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <!-- TIFF -->
            <StackPanel x:Name="TiffCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc tiff.compression}"/>
              <ComboBox x:Name="TiffCompressionCombo" SelectedIndex="1">
                <sys:String>raw</sys:String><sys:String>lzw</sys:String>
                <sys:String>deflate</sys:String><sys:String>packbits</sys:String>
              </ComboBox>
              <!-- TIFF DPI（2026-08-16 新增: 此前 TiffDpi 字段无 UI 控件，功能缺失） -->
              <TextBlock Text="{ext:Loc tiff.dpi}" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <NumericUpDown x:Name="TiffDpiBox" Value="0" Minimum="0" Maximum="2400" Increment="72" MinWidth="88"/>
                <TextBlock Text="{ext:Loc tiff.dpi.hint}" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </StackPanel>
            </StackPanel>
            <!-- JPEG XR (JxrEncApp) -->
            <StackPanel x:Name="JxrCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="{ext:Loc jxr.encoder.title}" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="{ext:Loc jxr.encoder.desc}" FontSize="10"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <!-- Thumbnail (EXIF IFD1 embed). Visibility/IsEnabled are capability driven:
                 see UpdateCodecPanelVisibility + ThumbnailService.CapabilityKey. -->
            <StackPanel x:Name="ThumbnailPanel" IsVisible="False" Spacing="4">
              <CheckBox x:Name="EnableThumbnailCheck" Content="{ext:Loc thumbnail.label}"/>
              <TextBlock Text="{ext:Loc thumbnail.size}" Margin="0,4,0,0" FontSize="11"/>
              <NumericUpDown x:Name="ThumbnailSizeBox" Value="160" Minimum="16" Maximum="512" Increment="16" MinWidth="88" HorizontalAlignment="Left"/>
              <TextBlock Text="{ext:Loc thumbnail.size.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="{ext:Loc thumbnail.quality}" Margin="0,4,0,0" FontSize="11"/>
              <NumericUpDown x:Name="ThumbnailQualityBox" Value="75" Minimum="1" Maximum="100" Increment="5" MinWidth="88" HorizontalAlignment="Left"/>
              <TextBlock Text="{ext:Loc thumbnail.quality.hint}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,0"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{ext:Loc metadata.mode}" Margin="0,6,0,0"/>
          <ComboBox x:Name="MetadataModeCombo" SelectedIndex="0"/>
          <Border x:Name="ExifToolPanel" IsVisible="False" Margin="0,4,0,0" Padding="8,6" CornerRadius="4"
                  BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{ext:Loc exiftool.privacy}" FontSize="13" FontWeight="Bold"/>
              <TextBlock x:Name="ExifToolHint" Text="{ext:Loc exiftool.detected}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
              <CheckBox x:Name="StripExifGpsCheck" Content="{ext:Loc strip.gps}"/>
              <CheckBox x:Name="StripExifTimeCheck" Content="{ext:Loc strip.time}"/>
              <CheckBox x:Name="StripExifCameraCheck" Content="{ext:Loc strip.camera}"/>
              <CheckBox x:Name="StripExifAllCheck" Content="{ext:Loc strip.all.exif}"/>
              <CheckBox x:Name="StripXmpCheck" Content="{ext:Loc strip.xmp}"/>
            </StackPanel>
          </Border>
          <CheckBox x:Name="AppendPngExtCheck" Content="{ext:Loc append.png.extension}"
                    Margin="0,2,0,0" FontSize="11"
                    ToolTip.Tip="{ext:Loc tip.append.ext}"/>
          <CheckBox x:Name="LosslessCheck" Content="{ext:Loc lossless}" Margin="0,4,0,0"/>

          <!-- 图片最长边限制 (缩放) -->
          <CheckBox x:Name="EnableMaxDimensionCheck" Content="{ext:Loc enable.max.dimension}"
                    Margin="0,6,0,0" FontSize="11"
                    ToolTip.Tip="{ext:Loc tip.max.dimension.enable}"/>
          <StackPanel x:Name="MaxDimensionPanel" Margin="0,2,0,0" Spacing="4">
            <TextBlock Text="{ext:Loc max.dimension}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumericUpDown x:Name="MaxDimensionBox" Value="1920" Minimum="1" Maximum="7680" Width="100" ToolTip.Tip="{ext:Loc tip.max.dimension.limit}"/>
              <TextBlock Text="px" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <TextBlock x:Name="MaxDimensionHint" Text="{ext:Loc max.dimension.hint}" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          </StackPanel>

          <!-- CPU 线程 (静态/动图/RAW 通用, 2026-08-15 移出 StillOptionsPanel:
               RAW 模式 dngtool 也支持 -threads, 需在此可见) -->
          <TextBlock Text="{ext:Loc cpu.threads}" Margin="0,4,0,0"/>
          <!-- ⚠ 用 WrapPanel 而非横向 StackPanel：左侧面板可用宽仅 ~236px，
               横向 StackPanel 溢出时**既不换行也不滚动** ⇒ ThreadHintLabel（动态文本）会被直接裁掉。
               WrapPanel 在宽度不足时自动折行（Avalonia 的 WrapPanel 无 Spacing，改用子元素 Margin）。 -->
          <WrapPanel>
            <CheckBox x:Name="AutoThreadsCheck" Content="{ext:Loc auto}" IsChecked="True" Margin="0,3,8,0"/>
            <CheckBox x:Name="SingleThreadCheck" Content="{ext:Loc single.thread}" Margin="0,3,8,0"/>
            <TextBlock x:Name="ThreadHintLabel" Text="" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11"/>
          </WrapPanel>
          <NumericUpDown x:Name="ThreadsBox" Value="4" Minimum="1" Maximum="64" IsEnabled="False"/>

          <Button Content="{ext:Loc generate.command}" Click="BuildCommand_Click" Margin="0,12,0,0" Padding="8"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

      <!-- ============ 右侧：队列 + 文件 + 命令 + 日志 ============ -->
      <!-- 2026-08-16: 行比例 2:1:2（队列与命令/日志优先），原均分导致 780px 高度下队列列表仅 ~100px -->
      <Grid Grid.Column="1" Margin="8,0,8,0" RowDefinitions="2*,6,*,6,2*,Auto">
        <!-- ① 转换队列 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="10,8"
                BoxShadow="0 1 6 0 #12000000"
                Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
          <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{ext:Loc conversion.queue}" FontSize="15" FontWeight="Bold"/>
              <TextBlock x:Name="FileCountLabel" Text="总文件: 0" FontSize="12"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="QueueList" SelectionMode="Single" Margin="0,4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:QueueItem">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DisplayText}"
                               Foreground="{Binding HasError, Converter={x:Static local:ErrorToColorConverter.Instance}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="10" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,4,0,0">
              <Button x:Name="ClearQueueButton" Content="{ext:Loc clear.queue}" Click="ClearQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc select.file}" Click="SelectFile_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc select.folder}" Click="SelectFolder_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc add.to.queue}" Click="AddToQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc delete.selected}" Click="DeleteSelected_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc start.queue}" Click="StartQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="{ext:Loc stop.queue}" Click="StopQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <CheckBox x:Name="StopAfterCurrentCheck" Content="{ext:Loc stop.after.current}"
                        VerticalAlignment="Center" Margin="4,0,0,3" IsChecked="True"/>
              <CheckBox x:Name="ShowErrorsOnlyCheck" Content="{ext:Loc show.errors.only}"
                        VerticalAlignment="Center" Margin="8,0,0,3"
                        ToolTip.Tip="{ext:Loc tip.queue.errors.only}"
                        IsCheckedChanged="ShowErrorsOnly_IsCheckedChanged"/>
              <Separator Width="12" Background="Transparent"/>
              <TextBlock x:Name="QueueProgressLabel" Text="队列: 0 / 0" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
              <TextBlock x:Name="QueueEtaLabel" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
              <TextBlock x:Name="ElapsedLabel" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
            </WrapPanel>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- ② 已选文件 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="10,8"
                BoxShadow="0 1 6 0 #12000000"
                Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{ext:Loc selected.files}" FontSize="14" FontWeight="Bold"/>
              <Button x:Name="FormatFilterBtn" Content="{ext:Loc format.filter}" FontSize="11"
                      Padding="6,2" Click="FormatFilter_Click"
                      ToolTip.Tip="{ext:Loc tip.media.filter}"/>
              <TextBlock x:Name="MediaFileCount" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11"/>
            </StackPanel>
            <Border Grid.Row="1" x:Name="MediaDropZone" Margin="0,4,0,0"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="4" MinHeight="80">
              <Grid RowDefinitions="*,Auto">
                <ListBox x:Name="MediaFileList" Grid.Row="0" SelectionMode="Single"
                         Background="Transparent"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="4">
                  <Button Content="{ext:Loc delete.selected}" Click="RemoveMediaFile_Click" Padding="6,2" FontSize="11"/>
                  <Button Content="{ext:Loc clear.queue}" Click="ClearMediaFiles_Click" Padding="6,2" FontSize="11"/>
                  <TextBlock Text="{ext:Loc double.click.hint}" VerticalAlignment="Center"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- ③ 命令 + 日志 -->
        <Border Grid.Row="4" CornerRadius="8" Padding="10,8"
                BoxShadow="0 1 6 0 #12000000"
                Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
          <Grid RowDefinitions="Auto,*,Auto,*">
            <TextBlock Grid.Row="0" Text="{ext:Loc generated.command}" FontSize="13" FontWeight="Bold"/>
            <TextBox Grid.Row="1" x:Name="CommandText" AcceptsReturn="True" IsReadOnly="True" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="2" Text="{ext:Loc execution.log}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
            <TextBox Grid.Row="3" x:Name="LogText" IsReadOnly="True" Margin="0,2,0,0"/>
          </Grid>
        </Border>

        <!-- ④ 并发控制栏 -->
        <Border Grid.Row="5" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                BoxShadow="0 1 6 0 #12000000"
                Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{ext:Loc concurrent.tasks}" VerticalAlignment="Center"/>
            <TextBox x:Name="ConcurrencyBox" Text="2" Width="56" VerticalAlignment="Center"
                     ToolTip.Tip="{ext:Loc tip.threads.range}"/>
            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
              <Button x:Name="ConcurrencyUpBtn" Content="▲" FontSize="8" Padding="6,1"
                      Click="ConcurrencyUp_Click"/>
              <Button x:Name="ConcurrencyDownBtn" Content="▼" FontSize="8" Padding="6,1"
                      Click="ConcurrencyDown_Click"/>
            </StackPanel>
            <TextBlock x:Name="ConcurrencyLabel" Text="(同时 2 个任务)" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Separator Width="8" Background="Transparent"/>
            <TextBlock x:Name="QueueCountLabel" Text="队列: 0" VerticalAlignment="Center"/>
            <Separator Width="8" Background="Transparent"/>
            <TextBlock Text="{ext:Loc process.priority}" VerticalAlignment="Center" FontSize="12"/>
              <ComboBox x:Name="PriorityCombo" SelectedIndex="3" Width="90" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 简洁模式覆盖面板（默认隐藏，IsVisible 切换）                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 简洁模式覆盖面板（默认隐藏，IsVisible 切换）                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Grid x:Name="SimpleModePanel" IsVisible="False"
          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ── 顶栏 ── -->
      <Border Grid.Row="0" Margin="12,8,12,0" Padding="14,10"
              CornerRadius="10" BoxShadow="0 2 12 0 #18000000"
              Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="SimpleReturnBtn" Content="{ext:Loc return.full}" FontSize="12"
                    Padding="10,5" Click="SimpleReturn_Click"/>
            <TextBlock Text="{ext:Loc simple.mode.title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{ext:Loc auto.encode}" VerticalAlignment="Center" FontSize="11"/>
            <ToggleSwitch x:Name="AutoEncodeToggle" IsCheckedChanged="AutoEncodeToggle_Changed"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── 预设选择器（独占一行，大号醒目） ── -->
      <Border Grid.Row="1" Margin="12,8,12,0" Padding="20,18"
              CornerRadius="12" BoxShadow="0 3 16 0 #20000000"
              Background="#18000000">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{ext:Loc preset.encoding.title}" FontSize="16" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="0,0,20,0"/>
          <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SimplePresetCombo"
                    FontSize="16" Padding="14,10"
                    SelectedIndex="0"/>
          <!-- 覆盖层的只读回显：显示的是高级模式当前的生效设置本身（取自同一批控件的当前显示值），
               而不是"最后点了哪条预设"；两者不符时后缀点名。 -->
          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SimpleCurrentStateLabel"
                     FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Grid>
      </Border>

      <!-- ── 控制栏（参数面板区域，队列上方） ── -->
      <Border Grid.Row="2" Margin="12,8,12,0" Padding="14,10"
              CornerRadius="10" BoxShadow="0 2 8 0 #10000000"
              Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{ext:Loc add.files}" FontSize="14" Padding="18,10"
                    Click="SimpleAddFiles_Click"/>
            <Button Content="{ext:Loc start.queue}" FontSize="14" Padding="18,10"
                    Click="SimpleStartQueue_Click"/>
            <Button Content="{ext:Loc stop.queue}" FontSize="14" Padding="18,10"
                    Click="SimpleStopQueue_Click"/>
            <Button Content="{ext:Loc clear}" FontSize="13" Padding="14,10"
                    Click="SimpleClearAll_Click"/>
            <CheckBox x:Name="SimpleErrorsOnlyCheck" Content="{ext:Loc show.errors.only}" FontSize="12" VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      IsCheckedChanged="SimpleErrorsOnly_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <TextBlock x:Name="SimpleStatusLabel" FontSize="12" Text="{ext:Loc ready}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock x:Name="SimpleProgressLabel" FontSize="12" Text="队列: 0/0"/>
            <TextBlock x:Name="SimpleEtaLabel" FontSize="12"/>
            <TextBlock x:Name="SimpleElapsedLabel" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── 转换队列列表 ── -->
      <Border Grid.Row="3" Margin="12,8,12,0" Padding="8"
              CornerRadius="10" BoxShadow="0 2 8 0 #10000000"
              Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock Text="{ext:Loc conversion.queue}" FontSize="13" FontWeight="Bold"/>
            <TextBlock x:Name="SimpleQueueCount" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center" Text="0 项"/>
          </StackPanel>
          <ListBox Grid.Row="1" x:Name="SimpleQueueList" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:QueueItem">
                <Border Padding="8,5" Margin="0,1" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" FontWeight="Medium"
                               Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Text="{Binding Status}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{Binding DurationText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="9" Margin="0,1,0,0"
                               Text="{Binding Log}" TextTrimming="CharacterEllipsis" MaxWidth="400"
                               Foreground="#E53935"
                               IsVisible="{Binding HasError}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- ── 拖放区域 ── -->
      <Border Grid.Row="4" Margin="12,8,12,10" Padding="12,10"
              CornerRadius="10" BoxShadow="0 2 12 0 #18000000"
              Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock Text="{ext:Loc drag.drop.hint}" FontSize="13" FontWeight="Bold"/>
            <TextBlock x:Name="SimpleFileCount" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center" Text="0 个文件"/>
            <Button Content="{ext:Loc clear}" FontSize="10" Padding="6,2" Margin="12,0,0,0"
                    Click="SimpleClearMedia_Click"/>
          </StackPanel>
          <Border Grid.Row="1" x:Name="SimpleDropZone" MinHeight="60"
                  BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <ListBox x:Name="SimpleMediaList" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock FontSize="12" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>