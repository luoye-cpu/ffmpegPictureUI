<Window
    x:Class="FfmpegGui.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:local="using:FfmpegGui.Models"
    Title="FFmpeg 图片转换器"
    Height="780"
    Width="1020"
    WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- 顶部设置栏 -->
    <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="FFmpeg 目录" VerticalAlignment="Center" FontSize="13"/>
          <TextBox x:Name="FfmpegPathBox" Width="240" VerticalAlignment="Center" IsReadOnly="True"/>
          <Button Content="浏览..." Click="BrowseFfmpeg_Click" Padding="8,4"/>
          <Separator Width="16" Background="Transparent"/>
          <TextBlock Text="输出目录" VerticalAlignment="Center" FontSize="13"/>
          <TextBox x:Name="OutputDirBox" Width="240" VerticalAlignment="Center" IsReadOnly="True"/>
          <Button Content="浏览..." Click="BrowseOutputDir_Click" Padding="8,4"/>
          <CheckBox x:Name="PreserveInputStructure" Content="保持输入目录结构" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
          <Button x:Name="ThemeToggleBtn" Content="🌙" FontSize="14" Padding="6,2"
                  ToolTip.Tip="切换深色/浅色模式" Click="ThemeToggle_Click"/>
        </StackPanel>
        <!-- 外部工具路径（留空自动检测） -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
          <TextBlock Text="JPEG XL 参考实现库" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Width="140"/>
          <TextBox x:Name="CjxlPathBox" Width="180" VerticalAlignment="Center" FontSize="11"
                   Watermark="留空自动检测"/>
          <Button Content="浏览" Click="BrowseCjxl_Click" Padding="6,2" FontSize="11"/>
          <Button Content="✕" Click="ClearCjxlPath_Click" Padding="6,2" FontSize="11"
                  ToolTip.Tip="清除手动路径，改回自动检测"/>
          <TextBlock Text="exiftool" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Width="44"/>
          <TextBox x:Name="ExifToolPathBox" Width="180" VerticalAlignment="Center" FontSize="11"
                   Watermark="自动检测"/>
          <Button Content="浏览" Click="BrowseExifTool_Click" Padding="6,2" FontSize="11"/>
          <Button Content="✕" Click="ClearExifToolPath_Click" Padding="6,2" FontSize="11"
                  ToolTip.Tip="清除手动路径，改回自动检测"/>
          <Button Content="🔄 重新检测" Click="RedetectTools_Click" Padding="8,2" FontSize="11"
                  ToolTip.Tip="清除所有手动路径，从同目录和系统 PATH 自动检测 cjxl / djxl / cjpegli / exiftool"/>
          <CheckBox x:Name="AutoUseSimdCheck" Content="自动使用 SIMD 优化二进制" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体两栏布局 -->
    <Grid ColumnDefinitions="270,*" RowDefinitions="*">
      <!-- ============ 左侧：参数控制面板 ============ -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Margin="10" Spacing="8">
          <TextBlock Text="参数控制面板" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="输出格式"/>
          <ComboBox x:Name="FormatCombo" SelectionChanged="FormatCombo_SelectionChanged">
            <sys:String>JPEG</sys:String>
            <sys:String>JPEG LI</sys:String>
            <sys:String>PNG</sys:String>
            <sys:String>WebP</sys:String>
            <sys:String>AVIF</sys:String>
            <sys:String>JPEG XL</sys:String>
            <sys:String>TIFF</sys:String>
          </ComboBox>
          <TextBlock Text="编码器" Margin="0,4,0,0"/>
          <ComboBox x:Name="EncoderCombo"/>
          <TextBlock Text="质量" Margin="0,8,0,0"/>
          <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" Value="92" />
          <TextBlock x:Name="QualityValue" Text="质量: 75"/>
          <TextBlock Text="色度采样"/>
          <ComboBox x:Name="ChromaCombo">
            <sys:String>auto</sys:String>
            <sys:String>4:4:4</sys:String>
            <sys:String>4:2:2</sys:String>
            <sys:String>4:2:0</sys:String>
          </ComboBox>
          <TextBlock Text="色彩空间" Margin="0,8,0,0"/>
          <ComboBox x:Name="ColorSpaceCombo">
            <sys:String>auto</sys:String>
            <sys:String>BT.601</sys:String>
            <sys:String>BT.709</sys:String>
            <sys:String>BT.2020</sys:String>
          </ComboBox>
          <CheckBox x:Name="UseAdvancedColor" Content="使用高级色彩参数" Margin="0,6,0,0" Checked="UseAdvancedColor_Checked" Unchecked="UseAdvancedColor_Unchecked"/>
          <StackPanel x:Name="AdvancedColorPanel" IsVisible="False" Margin="0,4,0,0" Spacing="6">
            <TextBlock Text="色彩基准（primaries）"/>
            <ComboBox x:Name="ColorPrimariesCombo">
              <sys:String>bt709</sys:String>
              <sys:String>bt470bg</sys:String>
              <sys:String>bt2020</sys:String>
            </ComboBox>
            <TextBlock Text="色彩传输函数（trc）"/>
            <ComboBox x:Name="ColorTrcCombo">
              <sys:String>iec61966-2-1</sys:String>
              <sys:String>bt709</sys:String>
              <sys:String>smpte2084</sys:String>
            </ComboBox>
            <TextBlock Text="色彩矩阵（colorspace）"/>
            <ComboBox x:Name="ColorMatrixCombo">
              <sys:String>bt709</sys:String>
              <sys:String>bt601</sys:String>
              <sys:String>bt2020</sys:String>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="位深"/>
          <ComboBox x:Name="BitDepthCombo">
            <sys:String>auto</sys:String>
            <sys:String>8</sys:String>
          </ComboBox>
          <CheckBox x:Name="UseAdvancedCodec" Content="高级编码选项" Margin="0,6,0,0" 
                    Checked="UseAdvancedCodec_Checked" Unchecked="UseAdvancedCodec_Unchecked"/>
          <StackPanel x:Name="AdvancedCodecPanel" IsVisible="False" Margin="0,4,0,0" Spacing="6">
            <!-- PNG -->
            <StackPanel x:Name="PngCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="预测模式 (pred)"/>
              <ComboBox x:Name="PngPredCombo">
                <sys:String>none</sys:String><sys:String>sub</sys:String><sys:String>up</sys:String>
                <sys:String>avg</sys:String><sys:String>paeth</sys:String><sys:String>mixed</sys:String>
              </ComboBox>
            </StackPanel>
            <!-- WebP -->
            <StackPanel x:Name="WebpCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="预设 (preset)"/>
              <ComboBox x:Name="WebpPresetCombo">
                <sys:String>none</sys:String><sys:String>default</sys:String><sys:String>picture</sys:String>
                <sys:String>photo</sys:String><sys:String>drawing</sys:String><sys:String>icon</sys:String>
                <sys:String>text</sys:String>
              </ComboBox>
              <TextBlock Text="无损压缩级别 (0-6)" Margin="0,4,0,0"/>
              <NumericUpDown x:Name="WebpCompressionBox" Value="4" Minimum="0" Maximum="6"/>
              <TextBlock Text="0=最快/最大, 6=最慢/最小" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <!-- AVIF -->
            <StackPanel x:Name="AvifCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="编码速度 (cpu-used)"/>
              <NumericUpDown x:Name="AvifCpuUsedBox" Value="5" Minimum="0" Maximum="8"/>
              <TextBlock Text="优化目标 (tune)" Margin="0,4,0,0"/>
              <ComboBox x:Name="AvifTuneCombo" SelectedIndex="3">
                <sys:String>0</sys:String><sys:String>1</sys:String>
                <sys:String>2</sys:String><sys:String>3</sys:String><sys:String>4</sys:String>
                <sys:String>5</sys:String>
              </ComboBox>
              <TextBlock Text="编码预设 (usage/preset)" Margin="0,4,0,0"/>
              <ComboBox x:Name="AvifPresetCombo">
                <sys:String>auto</sys:String><sys:String>good</sys:String>
                <sys:String>realtime</sys:String>
              </ComboBox>
              <CheckBox x:Name="AvifStillPictureCheck" Content="静态图片模式 (still-picture)" IsChecked="True"/>
              <CheckBox x:Name="AvifRowMtCheck" Content="行级多线程 (row-mt, 仅 libaom)" IsChecked="True" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- JPEG XL -->
            <StackPanel x:Name="JxlCodecPanel" IsVisible="False" Spacing="4">
              <!-- FFmpeg libjxl -->
              <StackPanel x:Name="JxlFfmpegPanel" IsVisible="True" Spacing="4">
                <TextBlock Text="编码努力 (effort)"/>
                <NumericUpDown x:Name="JxlEffortBox" Value="7" Minimum="1" Maximum="9"/>
                <CheckBox x:Name="JxlModularCheck" Content="强制 Modular 模式"/>
              </StackPanel>
              <!-- cjxl 外部工具 -->
              <StackPanel x:Name="JxlCjxlPanel" IsVisible="False" Spacing="4">
                <TextBlock Text="编码努力 (effort)"/>
                <NumericUpDown x:Name="CjxlEffortBox" Value="7" Minimum="1" Maximum="9"/>
                <CheckBox x:Name="CjxlProgressiveCheck" Content="渐进式解码 (--progressive)" Margin="0,4,0,0"/>
                <TextBlock Text="光子噪声 ISO (0=禁用)" Margin="0,4,0,0"/>
                <NumericUpDown x:Name="CjxlPhotonNoiseBox" Value="0" Minimum="0" Maximum="3200" Increment="100"/>
                <TextBlock Text="0=禁用, 100=低噪, 3200=高噪" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </StackPanel>
              <Border x:Name="JxlLosslessJpegHint" IsVisible="False" CornerRadius="4" Padding="6,3" Margin="0,4,0,0">
                <TextBlock x:Name="JxlLosslessJpegHintText" TextWrapping="Wrap" FontSize="11"/>
              </Border>
            </StackPanel>
            <!-- JPEG (FFmpeg mjpeg) -->
            <StackPanel x:Name="JpegCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="Huffman 策略"/>
              <ComboBox x:Name="JpegHuffmanCombo">
                <sys:String>default</sys:String><sys:String>optimal</sys:String>
              </ComboBox>
              <TextBlock Text="DCT 算法 (dct)" Margin="0,4,0,0"/>
              <ComboBox x:Name="JpegDctCombo" SelectedIndex="0">
                <sys:String>auto</sys:String><sys:String>int</sys:String>
                <sys:String>fastint</sys:String><sys:String>float</sys:String>
              </ComboBox>
            </StackPanel>
            <!-- JPEG-LI (cjpegli) -->
            <StackPanel x:Name="JpegliCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="色度子采样 (chroma_subsampling)"/>
              <ComboBox x:Name="JpegliChromaCombo" SelectedIndex="0">
                <sys:String>auto</sys:String><sys:String>444</sys:String>
                <sys:String>422</sys:String><sys:String>420</sys:String><sys:String>440</sys:String>
              </ComboBox>
              <TextBlock Text="渐进模式 (progressive)" Margin="0,4,0,0"/>
              <ComboBox x:Name="JpegliProgressiveCombo" SelectedIndex="0">
                <sys:String>自动</sys:String><sys:String>基线/标准</sys:String>
                <sys:String>渐进式</sys:String>
              </ComboBox>
              <CheckBox x:Name="JpegliOptimizeCheck" Content="优化 Huffman 编码 (--optimize)" IsChecked="True" Margin="0,4,0,0"/>
              <CheckBox x:Name="JpegliAdaptiveQuantCheck" Content="自适应量化 (--adaptive_q)" IsChecked="True"/>
              <TextBlock Text="编码器后端 (--jpeg_encoder)" Margin="0,4,0,0"/>
              <ComboBox x:Name="JpegliEncoderBackendCombo" SelectedIndex="0">
                <sys:String>libjpeg (标准)</sys:String>
                <sys:String>sjpeg (高级)</sys:String>
              </ComboBox>
              <Border x:Name="JpegliPsnrPanel" IsVisible="False" CornerRadius="4" Padding="6,3" Margin="0,4,0,0"
                      BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
                <StackPanel Spacing="3">
                  <TextBlock Text="PSNR 目标 (dB)" FontSize="11"/>
                  <NumericUpDown x:Name="JpegliPsnrBox" Value="0" Minimum="0" Maximum="60" Increment="0.5" FontSize="11"/>
                  <TextBlock Text="0=禁用, 推荐 40-50" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <!-- TIFF -->
            <StackPanel x:Name="TiffCodecPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="压缩算法"/>
              <ComboBox x:Name="TiffCompressionCombo">
                <sys:String>raw</sys:String><sys:String>lzw</sys:String>
                <sys:String>deflate</sys:String><sys:String>packbits</sys:String>
              </ComboBox>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="CPU 线程"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox x:Name="AutoThreadsCheck" Content="自动" IsChecked="True" Margin="0,3,0,0"/>
            <CheckBox x:Name="SingleThreadCheck" Content="单线程" Margin="0,3,0,0"/>
            <TextBlock x:Name="ThreadHintLabel" Text="" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11"/>
          </StackPanel>
          <NumericUpDown x:Name="ThreadsBox" Value="4" Minimum="1" Maximum="64" IsEnabled="False"/>
          <TextBlock Text="元数据处理" Margin="0,6,0,0"/>
          <ComboBox x:Name="MetadataModeCombo" SelectedIndex="0">
            <sys:String>保留所有元数据</sys:String>
            <sys:String>删除所有元数据</sys:String>
          </ComboBox>
          <Border x:Name="ExifToolPanel" IsVisible="False" Margin="0,4,0,0" Padding="8,6" CornerRadius="4"
                  BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="🔒 ExifTool 隐私清理" FontSize="13" FontWeight="Bold"/>
              <TextBlock x:Name="ExifToolHint" Text="已检测到 exiftool，可选择性删除以下元数据：" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
              <CheckBox x:Name="StripExifGpsCheck" Content="删除 GPS 位置信息" IsChecked="True"/>
              <CheckBox x:Name="StripExifTimeCheck" Content="删除拍摄时间日期"/>
              <CheckBox x:Name="StripExifCameraCheck" Content="删除相机/镜头型号与拍摄参数"/>
              <CheckBox x:Name="StripExifAllCheck" Content="删除全部 EXIF 数据"/>
              <CheckBox x:Name="StripXmpCheck" Content="删除 XMP 元数据"/>
            </StackPanel>
          </Border>
          <CheckBox x:Name="LosslessCheck" Content="无损编码" Margin="0,4,0,0"/>
          <Button Content="生成指令" Click="BuildCommand_Click" Margin="0,12,0,0" Padding="8"/>
          <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0"/>
          <TextBlock Text="预设管理" FontSize="14" FontWeight="Bold" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="导出预设" Click="ExportPreset_Click" Padding="8,4"/>
            <Button Content="导入预设" Click="ImportPreset_Click" Padding="8,4"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ 右侧：队列 + 文件 + 命令 + 日志 ============ -->
      <Grid Grid.Column="1" Margin="8" RowDefinitions="*,6,*,6,*,Auto">
        <!-- ① 转换队列 -->
        <Border Grid.Row="0" CornerRadius="6" Padding="8,6"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📋 转换队列" FontSize="15" FontWeight="Bold"/>
              <TextBlock x:Name="FileCountLabel" Text="总文件: 0" FontSize="12"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="QueueList" SelectionMode="Single" Margin="0,4">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayText}"
                             Foreground="{Binding HasError, Converter={x:Static local:ErrorToColorConverter.Instance}}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,4,0,0">
              <Button x:Name="ClearQueueButton" Content="清空队列" Click="ClearQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="选择文件..." Click="SelectFile_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="选择文件夹" Click="SelectFolder_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="添加到队列" Click="AddToQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="删除选中" Click="DeleteSelected_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="▶ 开始队列" Click="StartQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <Button Content="⏹ 停止队列" Click="StopQueue_Click" Padding="8,3" Margin="0,0,6,3"/>
              <CheckBox x:Name="StopAfterCurrentCheck" Content="完成后停止"
                        VerticalAlignment="Center" Margin="4,0,0,3" IsChecked="True"/>
              <Separator Width="12" Background="Transparent"/>
              <TextBlock x:Name="QueueProgressLabel" Text="队列: 0 / 0" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
              <TextBlock x:Name="QueueEtaLabel" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
              <TextBlock x:Name="ElapsedLabel" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="4,0,0,3"/>
            </WrapPanel>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- ② 已选文件 -->
        <Border Grid.Row="2" CornerRadius="6" Padding="8,6"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📂 已选文件" FontSize="14" FontWeight="Bold"/>
              <TextBlock x:Name="MediaFileCount" Text="" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11"/>
            </StackPanel>
            <Border Grid.Row="1" x:Name="MediaDropZone" Margin="0,4,0,0"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="4" MinHeight="80">
              <Grid RowDefinitions="*,Auto">
                <ListBox x:Name="MediaFileList" Grid.Row="0" SelectionMode="Single"
                         Background="Transparent"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="4">
                  <Button Content="删除选中" Click="RemoveMediaFile_Click" Padding="6,2" FontSize="11"/>
                  <Button Content="清空列表" Click="ClearMediaFiles_Click" Padding="6,2" FontSize="11"/>
                  <TextBlock Text="双击文件查看媒体信息" VerticalAlignment="Center"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- ③ 命令 + 日志 -->
        <Border Grid.Row="4" CornerRadius="6" Padding="8,6"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*,Auto,*">
            <TextBlock Grid.Row="0" Text="⚙ 生成的命令" FontSize="13" FontWeight="Bold"/>
            <TextBox Grid.Row="1" x:Name="CommandText" AcceptsReturn="True" IsReadOnly="True" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="2" Text="📜 执行日志" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
            <TextBox Grid.Row="3" x:Name="LogText" IsReadOnly="True" Margin="0,2,0,0"/>
          </Grid>
        </Border>

        <!-- ④ 并发控制栏 -->
        <Border Grid.Row="5" CornerRadius="6" Padding="8,5" Margin="0,6,0,0"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚡ 并行编码任务数" VerticalAlignment="Center"/>
            <TextBox x:Name="ConcurrencyBox" Text="2" Width="56" VerticalAlignment="Center"
                     ToolTip.Tip="请输入1-128之间的整数"/>
            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
              <Button x:Name="ConcurrencyUpBtn" Content="▲" FontSize="8" Padding="6,1"
                      Click="ConcurrencyUp_Click"/>
              <Button x:Name="ConcurrencyDownBtn" Content="▼" FontSize="8" Padding="6,1"
                      Click="ConcurrencyDown_Click"/>
            </StackPanel>
            <TextBlock x:Name="ConcurrencyLabel" Text="(同时 2 个任务)" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Separator Width="8" Background="Transparent"/>
            <TextBlock x:Name="QueueCountLabel" Text="队列: 0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>