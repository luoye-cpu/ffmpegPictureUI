<Window
    x:Class="FfmpegGui.ProgressWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:FfmpegGui.Controls"
    xmlns:ext="using:FfmpegGui"
    Title="{ext:Loc progress.title}" Width="720" Height="750"
    WindowStartupLocation="CenterOwner"
    MinWidth="560" MinHeight="420">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <!-- 标题行 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <TextBlock x:Name="TitleLabel" FontSize="18" FontWeight="Bold"/>
      <TextBlock x:Name="StatusBadge" Text="" FontSize="13" VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </StackPanel>

    <!-- TabControl -->
    <TabControl Grid.Row="1" x:Name="MainTabs" SelectedIndex="0">
      <!-- ═══ Tab 1: 转换详情 ═══ -->
      <TabItem Header="{ext:Loc progress.tab.convert}">
        <!-- ⚠ 行定义里 `*` 必须给**日志本体**：旧写法是 "Auto,Auto,*,Auto" ⇒ `*` 落在"📜 执行日志"
             那一行标题上，LogBox 待在 Auto 行 = 按内容撑高再被窗口底边裁掉 ⇒ 内部滚动器拿不到
             受限视口，用户"拉不动"。（维护者 2026-10-29 报） -->
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,6">
          <!-- 编码状态卡片 -->
          <Border Grid.Row="0" CornerRadius="8" Padding="14,10"
                  BoxShadow="0 1 6 0 #10000000"
                  Background="{DynamicResource SystemControlBackgroundCardHighBrush}">
            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="{ext:Loc progress.col.status}" Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="12"/>
              <TextBlock x:Name="StatusLabel" Grid.Row="0" Grid.Column="1" FontSize="12"/>
              <TextBlock Text="{ext:Loc progress.col.progress}" Grid.Row="1" Grid.Column="0" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock x:Name="ProgressLabel" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock Text="{ext:Loc progress.col.quality}" Grid.Row="2" Grid.Column="0" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock x:Name="QualityInfoLabel" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock Text="{ext:Loc progress.col.analysis}" Grid.Row="3" Grid.Column="0" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Spacing="4">
                <TextBlock x:Name="AnalysisLabel" Text="{ext:Loc progress.analysis.hint}" FontSize="11"/>
                <Button Content="{ext:Loc progress.analysis.btn}" Click="AnalyzeQuality_Click" Padding="8,4"
                        HorizontalAlignment="Left" FontSize="11"/>
              </StackPanel>
              <TextBlock Text="{ext:Loc progress.col.command}" Grid.Row="4" Grid.Column="0" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
              <TextBox x:Name="CommandLabel" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" IsReadOnly="True"
                       TextWrapping="Wrap" AcceptsReturn="True" Height="50" FontSize="11"
                       FontFamily="Consolas,monospace"/>
            </Grid>
          </Border>

          <!-- 媒体信息卡片 -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="180">
            <StackPanel x:Name="MediaInfoPanel" Margin="0,6,0,0" Spacing="6"/>
          </ScrollViewer>

          <!-- 日志标签 -->
          <TextBlock Grid.Row="2" Text="📜 执行日志" FontWeight="Bold" FontSize="13" Margin="0,6,0,4"/>

          <!-- 日志内容：滚动条显式声明（不靠主题默认）；长行按视觉换行 ⇒ 不横向滚动也能读完整行
               （`-106` 那几条 JxrDecApp 命令行实测单行 200+ 字符，旧形态右边直接被裁掉）。
               ⚠ 必须写成 `ScrollViewer.` 前缀的**附加属性**形式：`TextBox` 自己没有这两个属性
               （反射实测 VerticalScrollBarVisibilityProperty.IsAttached=True、OwnerType=ScrollViewer，
               主题的 TextBox 模板靠 TemplateBinding 读它们）；裸写属性名会当场
               AVLN2000 "Unable to resolve suitable regular or attached property ... on TextBox"。 -->
          <TextBox Grid.Row="3" x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True"
                   TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Consolas,monospace" FontSize="11"/>
        </Grid>
      </TabItem>

      <!-- ═══ Tab 2: 元数据编辑 ═══ -->
      <TabItem Header="{ext:Loc progress.tab.metadata}">
        <ctrl:MetadataEditor x:Name="MetadataEditorCtrl" Margin="0,6"/>
      </TabItem>
    </TabControl>

    <!-- 底部 -->
    <TextBlock Grid.Row="2" x:Name="FilePathLabel" Text="" FontSize="10" Margin="0,6,0,0"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
  </Grid>
</Window>
