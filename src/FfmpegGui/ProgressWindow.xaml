<Window
    x:Class="FfmpegGui.ProgressWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编码详情" Width="650" Height="560"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="Bold"/>
      <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,4"/>
      <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" >
        <TextBlock Text="状态" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
        <TextBlock x:Name="StatusLabel" Grid.Row="0" Grid.Column="1"/>
        <TextBlock Text="进度" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,4,0,0"/>
        <TextBlock x:Name="ProgressLabel" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"/>
        <TextBlock Text="质量" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,4,0,0"/>
        <TextBlock x:Name="QualityInfoLabel" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"/>
        <TextBlock Text="分析" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,4,0,0"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Spacing="4">
          <TextBlock x:Name="AnalysisLabel" Text="点击下方按钮分析 SSIM/PSNR"/>
          <Button Content="分析质量 (SSIM + PSNR)" Click="AnalyzeQuality_Click" Padding="8,4" 
                  HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBlock Text="命令" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,4,0,0"/>
        <TextBox x:Name="CommandLabel" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" IsReadOnly="True" 
                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
      </Grid>
      <TextBlock Text="执行日志" FontWeight="Bold" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBox x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" 
             Height="250" />
  </DockPanel>
</Window>
