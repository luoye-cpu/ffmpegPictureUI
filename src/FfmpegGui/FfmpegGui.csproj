<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════ -->
  <!-- 版本与目标框架                                      -->
  <!-- ═══════════════════════════════════════════════ -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 11 (NativeAOT 就绪) -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- PsnrCalculator 的 AVX2/SSE2 intrinsics 使用指针访问 (unsafe) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- Windows 条件编译符号 (Registry 等 Windows 专属 API) -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
    <!-- 版本号 -->
    <!-- ⚠ 预发布版本必须用连字符（SemVer）：1.6.0BETA1 会使 NuGet restore 直接失败（实测 2026-09-28） -->
    <Version>1.6.0-beta6</Version>
    <!-- exe/文件图标：真 ICO（16/24/32/48/64 五档，由 Resources/icon_raw.png 生成；旧那份"icon.ico"
         其实是 32×32 的 PNG 改了扩展名，进不了 ApplicationIcon）。⚠ Pillow 写出的 ICO 每条目都是 PNG 载荷，
         Windows shell 认，但 Avalonia/Skia 的 ICO 读取器会解成 1×1（UiTestHost C20c 实测抓到）
         ⇒ 运行时（托盘/窗口）用 icon_raw.png（见 App.LoadTrayIcon），这份 .ico 只作 ApplicationIcon。 -->
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- v2.0 过渡期：所有 CS0618 均为故意的旧字段回退逻辑 -->
    <!-- MSB3884: .NET SDK 默认引用 ManagedMinimumRules.ruleset 但文件不存在，安全忽略 -->
    <NoWarn>$(NoWarn);CS0618;MSB3884</NoWarn>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- 发布配置 (框架依赖, .NET 11 当前使用)                 -->
  <!-- ═══════════════════════════════════════════════ -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- TrimMode 仅在 PublishTrimmed=true 且 SelfContained=true 时有效 -->
    <!-- <TrimMode>partial</TrimMode> -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- NativeAOT 配置                                    -->
  <!-- 启用方法: pack.ps1 -Mode aot / dotnet publish -p:PublishAot=true -->
  <!-- 条件: 仅当 TFM 为 net11.0+ 时启用 (兼容未来 net12+)   -->
  <!-- ═══════════════════════════════════════════════ -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <!-- 注意: PublishAot 不在此处写死，由命令行 -p:PublishAot=true 控制，
         否则框架依赖模式 (self-contained false) 的 publish 也会被强制 AOT 而失败 -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- NativeAOT 隐含 PublishTrimmed=true；必须显式覆盖外层 PropertyGroup 的 false，
         否则报错 "PublishTrimmed is implied by native compilation and cannot be disabled" -->
    <PublishTrimmed>true</PublishTrimmed>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- TFM 回退到 net10 时强制不裁剪（避免 AOT 分析警告） -->
    <PublishTrimmed Condition="'$(TargetFramework)' == 'net10.0'">false</PublishTrimmed>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- NuGet 依赖                                         -->
  <!-- ═══════════════════════════════════════════════ -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <!-- 测试宿主访问 internal 成员 (PsnrCalculator 强制路径测试钩子等) -->
  <ItemGroup>
    <InternalsVisibleTo Include="GainMapTestHost" />
    <!-- 2026-10-05 物理拆分：GainMapTestHost 的 D 段拆成组工程后，原来靠
         `InternalsVisibleTo("GainMapTestHost")` 才可见的测试钩子（PsnrCalculator.SquaredDiffSumForced
         —— D27「各指令集路径数值一致性」的唯一入口）必须对**新宿主**同样可见，
         否则 D27 的 3~4 条断言在拆分后直接编不过，只能删断言或放宽判据，两者都是覆盖塌陷。
         ⚠ 加在这里而不是改 PsnrCalculator 的可见性：`internal` 是这只钩子的**刻意**形态
         （它绕过 SimdKernelRouting 的生产选路，只给测试用），改成 public 会把它暴露进产品 API。 -->
    <InternalsVisibleTo Include="Tests.GainMapDecode" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- NativeAOT 反射安全 (防止 System.Runtime.Intrinsics 被裁剪) -->
  <!-- ═══════════════════════════════════════════════ -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Runtime.Intrinsics" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="**/*.xaml" />
    <!-- ⚠ 托盘图标此前**没有**被记进 AvaloniaResource ⇒ `avares://FfmpegGui/Resources/icon.ico` 不存在
         ⇒ `App.LoadTrayIcon()` 里 `AssetLoader.Exists` 恒 false ⇒ 托盘只有菜单没有图标（静默回退）。
         ⚠ 现在收录的是 **PNG** 而不是 ico：Pillow 写出的 ICO 每条目都是 PNG 载荷（biSize=0x89PNG），
         Windows shell 认，但 Avalonia/Skia 的 ICO 读取器会解成 **1×1**（UiTestHost C20c 实测抓到）
         ⇒ 运行时（托盘/窗口）用 PNG，`.ico` 只作为 `<ApplicationIcon>` 给 exe 文件图标用。 -->
    <AvaloniaResource Include="Resources/icon_raw.png" />
  </ItemGroup>

  <!-- 多语言资源文件 -->
  <ItemGroup>
    <!--
      1) ExcludeFromSingleFile: PublishSingleFile 模式下默认会把 Content 嵌入 bundle，
         导致发布目录 Resources/Locales/ 为空 → 运行时找不到语言文件（v1.5.1 发布包缺陷）。
         排除后 json 将以物理文件形式随包输出，用户仍可自定义翻译。
      2) EmbeddedResource: 同时将 json 编译进程序集，作为外部文件缺失时的最后保障。
    -->
    <Content Include="Resources\Locales\*.json" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="Resources\Locales\*.json" />
  </ItemGroup>
</Project>