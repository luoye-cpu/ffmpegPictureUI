<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 主项目 TFM，升级 .NET 11 时改为 net11.0 -->
    <MainTfm>net10.0</MainTfm>
    <NoWarn>$(NoWarn);MSB3884</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference prebuilt FfmpegGui assembly to avoid rebuilding the main project (prevents file lock issues) -->
    <Reference Include="FfmpegGui">
      <HintPath>..\..\src\FfmpegGui\bin\$(Configuration)\$(MainTfm)\FfmpegGui.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>